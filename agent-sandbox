start_qemu() {
  if is_running qemu; then
    echo "VM already running, skipping"
    return
  fi

  echo "Starting QEMU/KVM..."

  # Run QEMU from the instance directory so anything it leaves behind at a
  # relative path lands in the sandbox state dir rather than in the user's
  # project, which is the directory the VM shares.
  local rc=0
  local -a pflash=()
  mapfile -t pflash < <(uefi_pflash_args)
  if [[ ${#pflash[@]} -eq 0 ]]; then
    echo "ERROR: no UEFI firmware to attach to the VM. Run 'agent-sandbox build'." >&2
    exit 1
  fi
  (
    cd "$INSTANCE_HOME" &&
    qemu-system-x86_64 \
      -name "$VM_NAME" \
      -accel "$SANDBOX_ACCEL" \
      -cpu "$VM_CPU_MODEL" -smp $VM_THREADS -m $VM_MEMORY_RAM \
      -display "none" -monitor "none" -serial "file:$QEMU_LOG" \
      -daemonize -pidfile "$QEMU_PIDFILE" \
      \
      "${pflash[@]}" \
      \
      -drive "file=$SESSION_IMAGE,if=virtio,format=qcow2" \
      \
      -device "virtio-net-pci,netdev=host" \
      -netdev "user,id=host,restrict=$VM_RESTRICT_NETWORK,hostfwd=tcp:127.0.0.1:$SSH_PORT-:22,hostfwd=tcp:127.0.0.1:$OPENCODE_VM_PORT-:$OPENCODE_VM_PORT,guestfwd=tcp:10.0.2.100:11434-cmd:socat - TCP:127.0.0.1:$HAPROXY_LISTEN_PORT,guestfwd=tcp:10.0.2.100:5000-cmd:socat - TCP:127.0.0.1:$REGISTRY_LISTEN_PORT,guestfwd=tcp:10.0.2.100:$HOST_PROXY_PORT-cmd:socat - TCP:127.0.0.1:$HOST_PROXY_PORT" \
      \
      -object "memory-backend-memfd,id=mem,size=$VM_MEMORY_RAM,share=on" \
      -numa "node,memdev=mem" \
      \
      -chardev "socket,id=fs0,path=$FS_SOCK" \
      -device "vhost-user-fs-pci,chardev=fs0,tag=workdir"
  ) || rc=$?

  if [[ $rc -ne 0 ]]; then
    echo "ERROR: QEMU failed to start (exit $rc). Console log: $QEMU_LOG" >&2
    exit 1
  fi
}

wait_for_ssh() {
  local tries=20
  until ssh -i "$SSH_KEY" -p "$SSH_PORT" \
    -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    "${VM_AGENT_USER}@127.0.0.1" "echo ok" >/dev/null 2>&1; do
    echo "Waiting for VM SSH on port $SSH_PORT..."
    sleep 5
    tries=$((tries - 1))
    if [[ "$tries" -le 0 ]]; then
      echo "VM SSH did not come up. Check $QEMU_LOG" >&2
      exit 1
    fi
  done
  echo "VM SSH is alive"
}

mount_workdir() {
    local mount_opts="" remount_opts=""
    if [[ "$VM_WORKDIR_RO" == "on" ]]; then
      mount_opts="-o ro"
      remount_opts="remount,ro"
      echo 'Binding current directory with VM (read-only)'
    else
      remount_opts="remount,rw"
      echo 'Binding current directory with VM'
    fi

    # The golden image carries an fstab entry, so a guest that has been rebooted
    # is already mounting the share. Remounting keeps the mount options honest
    # (--workdir-ro has to show up as 'ro' inside the guest, not only in
    # virtiofsd's --readonly) instead of stacking a second virtiofs mount on the
    # same path, which would hide the first one. A failure here is fatal: an
    # agent that cannot see the directory it was started in is worse than none.
    if ! _ssh root "
      mkdir -p $VM_AGENT_WORKDIR \
      ; modprobe virtiofs 2>/dev/null || true \
      ; if mountpoint -q $VM_AGENT_WORKDIR; then mount -o $remount_opts -t virtiofs workdir $VM_AGENT_WORKDIR; else mount $mount_opts -t virtiofs workdir $VM_AGENT_WORKDIR; fi
    "; then
      echo "ERROR: could not mount the shared directory inside the VM." >&2
      echo "       Check virtiofsd: $VIRTIOFSD_LOG" >&2
      exit 1
    fi
}

configure_vm_env() {
    echo 'Configuring VM environment...'
    _ssh root "
      printf '' > /etc/environment
      && echo 'RESTRICT_NETWORK=$VM_RESTRICT_NETWORK' >> /etc/environment
      && echo 'QEMU_PROXY_IP=10.0.2.100' >> /etc/environment
      && echo 'LOCAL_LLM_PORT=11434' >> /etc/environment
      && echo 'LOCAL_LLM_URL_BASE=http://10.0.2.100:11434' >> /etc/environment
      && echo 'LOCAL_LLM_URL_FULL=http://10.0.2.100:11434/v1' >> /etc/environment
      && echo 'DOCKER_REGISTRY=$REGISTRY_ENDPOINT' >> /etc/environment
    "
}

#--------------------------------------------------------------------------------
# The .env file in the working directory: LLM_API_KEY and OPENCODE_PASSWORD.
# Read on every run, so editing it and rerunning 'agent-sandbox run' is all it
# takes to change either value.
#--------------------------------------------------------------------------------

# Last assignment of a key in $ENV_FILE; fails if the key is absent or empty.
env_file_value(){
  local key="$1" value=""
  [[ -f "$ENV_FILE" ]] || return 1
  value="$(awk -v k="$key" '
      $0 ~ "^[[:space:]]*"k"[[:space:]]*=" { sub(/^[^=]*=/, "", $0); v = $0 }
      END { sub(/[ \t\r]+$/, "", v); if (v != "") print v }' "$ENV_FILE")"
  if [[ "$value" == '"'*'"' && ${#value} -ge 2 ]]; then
    value="${value:1:${#value}-2}"
  elif [[ "$value" == "'"*"'" && ${#value} -ge 2 ]]; then
    value="${value:1:${#value}-2}"
  fi
  [[ -n "$value" ]] || return 1
  printf '%s\n' "$value"
}

# The key is written into JSON config and into a shell-safe guest file, so keep
# its alphabet narrow rather than trying to quote whatever the user typed.
validate_api_key(){
  [[ -z "$LLM_API_KEY" ]] && return 0
  if [[ ! "$LLM_API_KEY" =~ ^[A-Za-z0-9._:+/=-]+$ ]]; then
    echo "ERROR: LLM_API_KEY in $ENV_FILE uses unsupported characters." >&2
    echo "       Letters, digits and . _ : + / = - only (it is written into the" >&2
    echo "       in-VM OpenCode config as JSON)." >&2
    exit 1
  fi
}

write_env_file(){
  local why="$1"
  if ! (
    umask 077
    cat > "$ENV_FILE" <<EOF
# agent-sandbox settings - edit these two values, then rerun 'agent-sandbox run'.
# Everything here is also visible inside the VM as /home/agent/workdir/.env.

# API key sent to the LLM at --local-llm-host. Leave empty for an LLM that needs no key.
LLM_API_KEY=$LLM_API_KEY

# Password for the OpenCode UI and API (Basic auth user 'opencode').
# Change it here and rerun 'agent-sandbox run' to apply it.
OPENCODE_PASSWORD=$OPENCODE_PASSWORD
EOF
  ); then
    echo "ERROR: could not write $ENV_FILE." >&2
    echo "       Is this directory writable? ('agent-sandbox run' needs to keep these settings.)" >&2
    exit 1
  fi
  chmod 0600 "$ENV_FILE" 2>/dev/null || true
  echo "  Settings: $ENV_FILE ($why)"
}

# Reads $ENV_FILE, generating the password when it is missing or blank, and leaves
# a complete file behind so the next run reuses it.
load_env_file(){
  LLM_API_KEY="$(env_file_value LLM_API_KEY || true)"
  OPENCODE_PASSWORD="$(env_file_value OPENCODE_PASSWORD || true)"

  # Older releases generated the password inside the instance directory.
  if [[ -z "$OPENCODE_PASSWORD" ]] && [[ -f "$LEGACY_ENV_FILE" ]]; then
    OPENCODE_PASSWORD="$(sed -n 's/^OPENCODE_PASSWORD=//p' "$LEGACY_ENV_FILE" | head -n1 || true)"
    [[ -n "$OPENCODE_PASSWORD" ]] && echo "  Migrating the OpenCode password from $LEGACY_ENV_FILE"
  fi

  # A blank OPENCODE_PASSWORD means "generate one", never "run without a password".
  if [[ -z "$OPENCODE_PASSWORD" ]]; then
    OPENCODE_PASSWORD="$(random_password)"
  fi
  validate_api_key

  if [[ ! -f "$ENV_FILE" ]] && [[ "$VM_WORKDIR_RO" == "on" ]]; then
    echo "ERROR: --workdir-ro, and there is no $ENV_FILE to read the settings from." >&2
    echo "       Run once without --workdir-ro (that creates it), or create it yourself:" >&2
    printf '         LLM_API_KEY=<your key, or empty>\n' >&2
    printf '         OPENCODE_PASSWORD=<your password>\n' >&2
    exit 1
  fi

  if [[ ! -f "$ENV_FILE" ]]; then
    write_env_file created
  else
    write_env_file loaded
  fi
  [[ -f "$LEGACY_ENV_FILE" ]] && rm -f "$LEGACY_ENV_FILE"
  return 0
}

# Warn when the settings file sits in a git working tree that would commit it.
warn_if_env_not_ignored(){
  have_cmd git || return 0
  git -C "$WORKDIR" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0
  git -C "$WORKDIR" check-ignore -q .env && return 0
  echo "  Warning: $WORKDIR is a git working tree and .env is not ignored."
  echo "           Add '.env' to .gitignore so the LLM key and password stay out of commits."
}

# Emits the OpenCode V2 config: a single custom OpenAI-compatible provider that
# points at the host LLM proxy, reachable inside the VM as 10.0.2.100:11434.
opencode_config_json(){
  local model=$1
  local context_size=$2
  local api_key="${3:-local}"
  {
    printf '%s\n' '{'
    printf '%s\n' '  "$schema": "https://opencode.ai/config.json",'
    printf '%s\n' '  "model": "local/'"$model"'",'
    printf '%s\n' '  "providers": {'
    printf '%s\n' '    "local": {'
    printf '%s\n' '      "name": "Local",'
    printf '%s\n' '      "package": "@opencode/ai/providers/openai-compatible",'
    printf '%s\n' '      "settings": {'
    printf '%s\n' '        "baseURL": "http://10.0.2.100:11434/v1",'
    printf '%s\n' '        "apiKey": "'"$api_key"'"'
    printf '%s\n' '      },'
    printf '%s\n' '      "models": {'
    printf '%s\n' '        "'"$model"'": {'
    printf '%s\n' '          "name": "'"$model"'",'
    printf '%s\n' '          "capabilities": {'
    printf '%s\n' '            "tools": true,'
    printf '%s\n' '            "input": ["text", "image"],'
    printf '%s\n' '            "output": ["text"]'
    printf '%s\n' '          },'
    printf '%s\n' '          "limit": {'
    printf '%s\n' '            "context": '"$context_size"','
    printf '%s\n' '            "output": '"$((context_size / 2))"
    printf '%s\n' '          }'
    printf '%s\n' '        }'
    printf '%s\n' '      }'
    printf '%s\n' '    }'
    printf '%s\n' '  },'
    printf '%s\n' '  "permissions": ['
    printf '%s\n' '    { "action": "*", "resource": "*", "effect": "allow" }'
    printf '%s\n' '  ]'
    printf '%s\n' '}'
  }
}

# systemd unit for the OpenCode server. Runs as the agent user; the credential
# file is root-owned so it is only readable by systemd (before setuid).
opencode_unit_text(){
  {
    printf '%s\n' '[Unit]'
    printf '%s\n' 'Description=OpenCode V2 server (agent-sandbox)'
    printf '%s\n' 'After=network-online.target docker.service'
    printf '%s\n' 'Wants=docker.service'
    printf '%s\n' ''
    printf '%s\n' '[Service]'
    printf '%s\n' 'Type=simple'
    printf '%s\n' 'User='"$VM_AGENT_USER"
    printf '%s\n' 'Group='"$VM_AGENT_USER"
    printf '%s\n' 'WorkingDirectory='"$VM_AGENT_WORKDIR"
    printf '%s\n' 'Environment=HOME=/home/'"$VM_AGENT_USER"
    printf '%s\n' 'EnvironmentFile=/etc/opencode/server.env'
    printf '%s\n' 'ExecStart=/usr/local/bin/opencode serve --hostname 0.0.0.0 --port '"$OPENCODE_VM_PORT"
    printf '%s\n' 'Restart=always'
    printf '%s\n' 'RestartSec=2'
    printf '%s\n' 'StandardOutput=append:/home/'"$VM_AGENT_USER"'/.local/state/opencode/opencode.log'
    printf '%s\n' 'StandardError=append:/home/'"$VM_AGENT_USER"'/.local/state/opencode/opencode.err'
    printf '%s\n' '# Hardening knobs. Drop ProtectSystem if a session needs to write outside'
    printf '%s\n' '# HOME and the workdir (for example apt-get or npm install -g).'
    printf '%s\n' 'ProtectSystem=full'
    printf '%s\n' 'ProtectKernelTunables=yes'
    printf '%s\n' 'ProtectKernelLogs=yes'
    printf '%s\n' 'PrivateTmp=yes'
    printf '%s\n' 'LimitNOFILE=65536'
    printf '%s\n' ''
    printf '%s\n' '[Install]'
    printf '%s\n' 'WantedBy=multi-user.target'
  }
}

start_opencode(){
  local model=$1
  local context_size=$2

  # load_env_file has already read (or generated) the password from $ENV_FILE,
  # so an unchanged file keeps browser sessions working across restarts, and
  # editing the file + rerunning replaces the password in the service too.
  echo
  echo "Starting OpenCode V2 as a systemd service..."

  # _ssh() intentionally removes newlines from remote commands, so do not
  # use heredocs here. Encode the small config/service files instead.
  local opencode_config_b64
  local opencode_env_b64
  local opencode_unit_b64

  # OpenCode V2 config: one custom OpenAI-compatible provider pointing at the
  # host LLM proxy exposed inside the VM as 10.0.2.100:11434. LLM_API_KEY comes
  # from $ENV_FILE; an empty key keeps the placeholder the LLMs here accept.
  opencode_config_b64="$(opencode_config_json "$model" "$context_size" \
    "${LLM_API_KEY:-local}" | base64 -w0)"

  # Root-owned env file: systemd reads it before dropping privileges, so the
  # agent user cannot read the server password out of /proc/1/environ style paths.
  opencode_env_b64="$({
    printf '%s\n' 'OPENCODE_PASSWORD='"$OPENCODE_PASSWORD"
    printf '%s\n' 'OPENCODE_DISABLE_FREE_MODELS=1'
  } | base64 -w0)"

  opencode_unit_b64="$(opencode_unit_text | base64 -w0)"

  # 'install -d' leaves the intermediate directories root-owned, and OpenCode
  # needs to create ~/.local/share itself, so chown every component explicitly.
  if ! _ssh root "
    mkdir -p /home/$VM_AGENT_USER/.config/opencode /home/$VM_AGENT_USER/.local/state/opencode /home/$VM_AGENT_USER/.local/share/opencode
    && chown $VM_AGENT_USER:$VM_AGENT_USER /home/$VM_AGENT_USER/.config /home/$VM_AGENT_USER/.local /home/$VM_AGENT_USER/.config/opencode /home/$VM_AGENT_USER/.local/state /home/$VM_AGENT_USER/.local/share /home/$VM_AGENT_USER/.local/state/opencode /home/$VM_AGENT_USER/.local/share/opencode
    && printf '%s' '$opencode_config_b64' | base64 -d > /home/$VM_AGENT_USER/.config/opencode/opencode.json
    && chown $VM_AGENT_USER:$VM_AGENT_USER /home/$VM_AGENT_USER/.config/opencode/opencode.json
    && install -d -m 0755 /etc/opencode
    && printf '%s' '$opencode_env_b64' | base64 -d > /etc/opencode/server.env
    && chmod 0600 /etc/opencode/server.env
    && printf '%s' '$opencode_unit_b64' | base64 -d > /etc/systemd/system/opencode.service
    && chmod 0644 /etc/systemd/system/opencode.service
    && systemctl daemon-reload
    && systemctl enable opencode
    && systemctl restart opencode
  "
  then
    echo "ERROR: could not install the OpenCode service in the VM." >&2
    exit 1
  fi

  wait_for_opencode "$OPENCODE_PASSWORD"

  local -a lan_addrs=()
  mapfile -t lan_addrs < <(host_ipv4_addresses)
  local lan_url="http://<this host's address>:$OPENCODE_WEB_PORT"
  [[ ${#lan_addrs[@]} -gt 0 ]] && lan_url="http://${lan_addrs[0]}:$OPENCODE_WEB_PORT"
  local guest_url="${OPENCODE_GUEST_URL:-http://vm.address:$OPENCODE_VM_PORT}"

  echo
  echo "============================================================"
  echo "OpenCode V2 is running inside the VM as a systemd service."
  echo
  echo "  Settings: $ENV_FILE"
  echo "    LLM_API_KEY        the key the agent sends to $LOCAL_LLM_HOST:$LOCAL_LLM_SERVER_PORT"
  echo "    OPENCODE_PASSWORD  sign-in password for the UI and the API (Basic auth user 'opencode')"
  echo "  Edit that file (mode 0600) and rerun 'agent-sandbox run' to change either one."
  echo "  It is not printed here on purpose, and the file is world-readable inside the VM"
  echo "  as $VM_AGENT_WORKDIR/.env, so keep the workdir shared only with directories you trust."
  echo
  echo "  Connect to the agent (published on 0.0.0.0, protected by Basic auth):"
  echo
  if [[ ${#lan_addrs[@]} -gt 0 ]]; then
    printf '    Browser     http://%s:%s\n' "${lan_addrs[0]}" "$OPENCODE_WEB_PORT"
    for ip in "${lan_addrs[@]:1}"; do
      printf '                http://%s:%s\n' "$ip" "$OPENCODE_WEB_PORT"
    done
  else
    printf '    Browser     %s\n' "$lan_url"
  fi
  echo "              the same address works from this machine and from any other one"
  echo "              on this network; pick 'Use password', then server address = the URL"
  echo "              you opened and password = OPENCODE_PASSWORD from the settings file."
  echo
  echo "    HTTP API    PW=\$(sed -n 's/^OPENCODE_PASSWORD=//p' $ENV_FILE)"
  echo "                curl -u \"opencode:\$PW\" $lan_url/api/session"
  echo "                POST /api/session, POST /api/session/<id>/prompt {\"text\":\"...\"},"
  echo "                GET /api/session/<id>/message; GET /openapi.json documents everything."
  echo
  echo "    OpenCode CLI, inside the VM (as $VM_AGENT_USER, in the shared workdir):"
  printf '                agent-sandbox ssh %s "cd %s && OPENCODE_PASSWORD=$PW \\\n' \
    "$VM_AGENT_USER" "$VM_AGENT_WORKDIR"
  printf '                  opencode --server %s run %syour prompt%s"\n' \
    "$guest_url" "'" "'"
  echo "                Inside the VM use the VM's own address ($guest_url): the published"
  echo "                port is not reachable from the guest itself."
  echo
  echo "    A CLI on another machine can call 'opencode --server $lan_url api <operation>'"
  echo "    but cannot start a session there: the session directory has to exist inside the"
  echo "    VM, so the browser is the remote UI."
  echo
  echo "  Status:  agent-sandbox ssh root 'systemctl status opencode'"
  echo "  Logs:    agent-sandbox ssh root 'tail -n 50 /home/$VM_AGENT_USER/.local/state/opencode/opencode.log'"
  echo "============================================================"
  echo
}

# /api/info answers 200 only with the right Basic auth (401 otherwise), which
# makes it both a readiness probe and a credential check.
wait_for_opencode(){
  local password=$1
  local tries=24 info="" code=000

  echo "Waiting for OpenCode on port $OPENCODE_WEB_PORT..."
  while [[ "$tries" -gt 0 ]]; do
    info="$(curl -s -m 3 -u "opencode:$password" "http://127.0.0.1:$OPENCODE_WEB_PORT/api/info" 2>/dev/null || true)"
    code="$(printf '%s' "$info" | sed -n 's/.*"version":"\([^"]*\)".*/\1/p' | head -n1 || true)"
    [[ -n "$code" ]] && break
    sleep 2.5
    tries=$((tries - 1))
  done

  if [[ -z "$code" ]]; then
    echo "ERROR: OpenCode did not answer on port $OPENCODE_WEB_PORT." >&2
    _ssh root "systemctl status opencode --no-pager; tail -n 40 /home/$VM_AGENT_USER/.local/state/opencode/opencode.log /home/$VM_AGENT_USER/.local/state/opencode/opencode.err" || true
    exit 1
  fi
  # /api/info also lists the addresses the server listens on inside the VM; the
  # non-loopback one is what an in-guest CLI has to use.
  OPENCODE_GUEST_URL="$(printf '%s' "$info" |
    sed -n 's/.*"urls":\[\([^]]*\)\].*/\1/p' | tr ',' '\n' | tr -d '"' |
    grep -v '^http://127' | head -n1 || true)"
  echo "OpenCode $code is answering on :$OPENCODE_WEB_PORT"
}

#--------------------------------------------------------------------------------
# _run: orchestrates full startup (with restart-if-running logic)
#--------------------------------------------------------------------------------

_run(){
  local model="${1:-$CMD_DEFAULT_MODEL}"
  local context_size="${2:-$CMD_DEFAULT_CONTEXT_SIZE}"
  local dns_whitelist_csv="${3:-}"

  # Read/create the settings file first: a bad value must fail before a running
  # instance is torn down, and the file has to exist before the workdir is shared.
  load_env_file
  warn_if_env_not_ignored

  if is_running qemu; then
    echo "============================================================"
    echo " Instance $INSTANCE_ID already running."
    echo " Stopping and restarting with updated settings..."
    echo "============================================================"
    _stop
    sleep 2
  fi

  if [[ ! -f "$GOLDEN_IMAGE" ]]; then
    echo "ERROR: Golden image not found. Run 'agent-sandbox build' first."
    exit 1
  fi

  if [[ -f "$IMAGE_STAMP" ]] && ! grep -q "^base_image=$DOWNLOAD_IMAGE$" "$IMAGE_STAMP"; then
    echo "WARNING: the golden image was built from a different base image:"
    sed -n 's/^/  /p' "$IMAGE_STAMP"
    echo "         Re-run 'agent-sandbox build' to pick up the current one."
    echo
  fi

  ensure_prereqs
  create_session_overlay

  if [[ "$VM_RESTRICT_NETWORK" == "on" ]] && [[ -n "$dns_whitelist_csv" ]]; then
    install_whitelist "$dns_whitelist_csv"
  elif [[ "$VM_RESTRICT_NETWORK" == "on" ]] && [[ -f "$WHITELIST_FILE" ]]; then
    # Fail-safe: a whitelist left by an earlier run of this directory keeps the
    # VM locked down. 'purge' forgets it, --dns-whitelist replaces it.
    echo "  Reusing the whitelist from an earlier run ($(wc -l < "$WHITELIST_FILE") domain(s))."
    echo "  Pass --dns-whitelist to replace it, or 'agent-sandbox purge' to drop it."
  fi

  start_virtiofsd
  start_haproxy
  start_registry

  if [[ "$VM_RESTRICT_NETWORK" == "on" ]] && [[ -f "$WHITELIST_FILE" ]]; then
    start_host_proxy
  fi

  start_qemu
  wait_for_ssh
  mount_workdir
  configure_vm_env

  if [[ "$VM_RESTRICT_NETWORK" == "on" ]] && [[ -f "$WHITELIST_FILE" ]]; then
    setup_vm_firewall
  else
    teardown_vm_firewall
    if [[ "$VM_RESTRICT_NETWORK" == "on" ]]; then
      echo "  No DNS whitelist: the VM can reach only the LLM proxy, the registry and"
      echo "  the shared workdir. Outbound name resolution needs --dns-whitelist,"
      echo "  because QEMU's user-mode resolver cannot reach a stub resolver on the host."
    fi
  fi

  start_opencode "$model" "$context_size"
}

#--------------------------------------------------------------------------------
# SSH
#--------------------------------------------------------------------------------

ssh_into_vm() {
  local user=$1
  shift
  local cmd="$(tr -d '\n' <<< "$*")"
  echo "Running \`$cmd\` inside VM as \`$user\` on port $SSH_PORT"
  ssh -tt -i "$SSH_KEY" -p "$SSH_PORT" \
    -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    "$user@127.0.0.1" \
    "cd $VM_AGENT_WORKDIR 2>/dev/null || true; exec bash -lc $(printf '%q' "$cmd")"
}

_ssh(){
  ssh_into_vm "$@"
}

#--------------------------------------------------------------------------------
# SYNC
#--------------------------------------------------------------------------------

sync_docker() {
  local filter_regex="$1"
  if ! have_cmd docker; then
    echo "ERROR: 'sync docker' needs a local docker CLI (and a running daemon) on this host." >&2
    exit 1
  fi
  if ! docker images --format '{{.Repository}}:{{.Tag}}' > /dev/null 2>&1; then
    echo "ERROR: the local docker daemon is not reachable." >&2
    exit 1
  fi
  echo "Syncing Docker images to registry at 127.0.0.1:$REGISTRY_LISTEN_PORT..."
  local images="" rc=0
  images="$(docker images --format '{{.Repository}}:{{.Tag}}' | grep -v '127.0.0.1' | grep -E "$filter_regex")" || rc=$?
  if [[ "$rc" -ge 2 ]]; then
    echo "ERROR: invalid filter expression '$filter_regex'." >&2
    exit 1
  fi
  if [[ -z "$images" ]]; then
    echo "Nothing to sync (no local image matches '$filter_regex')."
    return
  fi
  while IFS= read -r img; do
    echo
    echo "Syncing $img"
    local target="127.0.0.1:$REGISTRY_LISTEN_PORT/$img"
    docker tag "$img" "$target"
    docker push "$target"
  done <<< "$images"
}

sync_files() {
  local sync_arg="$1"
  local host_path="$sync_arg"
  local vm_path=""

  if [[ "$host_path" == *:* ]]; then
    host_path="${sync_arg%%:*}"
    vm_path="${sync_arg#*:}"
  fi

  [[ -z "$vm_path" ]] && vm_path="$host_path"

  local ssh_user=""
  if [[ "$vm_path" == /home/* ]]; then
    vm_path="/home/$VM_AGENT_USER/${vm_path#/home/*/}"
    ssh_user="$VM_AGENT_USER"
  elif [[ "$vm_path" == /tmp/* ]]; then
    ssh_user="$VM_AGENT_USER"
  else
    ssh_user="root"
  fi

  vm_path="${vm_path%/}"

  if [[ ! -e "$host_path" ]]; then
    echo "ERROR: Path '$host_path' does not exist"
    exit 1
  fi

  if [[ -d "$host_path" ]]; then
    host_path="${host_path%/}/"
  fi

  echo "Syncing $host_path -> $vm_path (rsync incremental)"
  local vm_dir
  vm_dir=$(dirname "$vm_path")
  # Make sure the target directory exists *and* is writable by the user rsync
  # connects as: a root-owned directory used to reject the agent user's write
  # ("rsync: [receiver] mkstemp ... Permission denied").
  if [[ "$ssh_user" == root ]]; then
    if ! _ssh root "mkdir -p '$vm_dir'"; then
      echo "ERROR: could not create $vm_dir in the VM" >&2
      exit 1
    fi
  else
    if ! _ssh root "mkdir -p '$vm_dir' && chown '$ssh_user' '$vm_dir'"; then
      echo "ERROR: could not create $vm_dir in the VM for user $ssh_user" >&2
      exit 1
    fi
  fi

  if ! rsync -az --partial \
    -e "ssh -i $SSH_KEY -p $SSH_PORT -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null" \
    "$host_path" "${ssh_user}@127.0.0.1:${vm_path%/}"
  then
    echo "ERROR: rsync into the VM failed" >&2
    exit 1
  fi
}

_sync(){
  local sync_mode="$1"
  local sync_arg="${2:-}"

  if ! is_running qemu; then
    echo "ERROR: VM is not running. Unable to sync"
    exit 1
  fi

  case "$sync_mode" in
    docker) sync_docker "${sync_arg:-.*}" ;;
    file)   sync_files "$sync_arg" ;;
    *)      echo "ERROR: Unknown sync mode '$sync_mode'. Use 'docker' or 'file'."; exit 1 ;;
  esac
}

#--------------------------------------------------------------------------------
# STATUS
#--------------------------------------------------------------------------------

get_pids() {
  local instance_dir="$1"
  local pid_list=""
  local pidfile
  while IFS= read -r pidfile; do
    local pname="$(basename "$pidfile" .pid)"
    local pid="$(cat "$pidfile" 2>/dev/null || echo stopped)"
    [[ -n "$pid_list" ]] && pid_list="$pid_list, "
    pid_list="${pid_list}${pname}:${pid}"
  done < <(instance_pidfiles "$instance_dir")
  echo "$pid_list"
}

is_session_active() {
  local instance_dir="$1"
  local pidfile pid
  while IFS= read -r pidfile; do
    pid="$(cat "$pidfile" 2>/dev/null)"
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
  done < <(instance_pidfiles "$instance_dir")
  return 1
}

_status(){
  if [[ ! -d "$SANDBOX_HOME/instances" ]]; then
    echo "No sessions found."
    return
  fi

  local found=0
  local max_id_len=7
  local -a lines=()

  for instance_dir in "$SANDBOX_HOME"/instances/*/; do
    if [[ ! -d "$instance_dir" ]]; then
      continue
    fi
    found=1
    local session_id="$(basename "$instance_dir")"
    local instance_path=""
    if [[ -f "$instance_dir/.instance_path" ]]; then
      instance_path="$(cat "$instance_dir/.instance_path")"
    else
      instance_path="(unknown)"
    fi
    local pids
    pids="$(get_pids "$instance_dir")"
    if [[ ${#session_id} -gt $max_id_len ]]; then max_id_len=${#session_id}; fi
    lines+=("$session_id|$instance_path|$pids|$instance_dir")
  done

  if [[ "$found" -eq 0 ]]; then
    echo "No sessions found."
    return
  fi

  printf "\n"
  printf "%-${max_id_len}s  %-4s  %-40s  %s\n" "SESSION" "STATUS" "PATH" "PIDS"
  local sep_id sep_status sep_path sep_pids
  sep_id="$(printf '%*s' "$max_id_len" '' | tr ' ' '-')"
  sep_status="$(printf '%*s' 4 '' | tr ' ' '-')"
  sep_path="$(printf '%*s' 40 '' | tr ' ' '-')"
  sep_pids="$(printf '%*s' 40 '' | tr ' ' '-')"
  printf "%s  %s  %s  %s\n" "$sep_id" "$sep_status" "$sep_path" "$sep_pids"

  for line in "${lines[@]}"; do
    local session_id="${line%%|*}"
    local rest="${line#*|}"
    local display_path="${rest%%|*}"
    rest="${rest#*|}"
    local pids="${rest%%|*}"
    local instance_dir="${rest##*|}"

    local status_display
    if is_session_active "$instance_dir"; then
      status_display="on"
    else
      status_display="off"
    fi

    local pid_display="${pids:--}"
    printf "%-${max_id_len}s  %-4s  %-40s  %s\n" "$session_id" "$status_display" "$display_path" "$pid_display"
  done

  printf "\n"
}

#--------------------------------------------------------------------------------
# STOP
#--------------------------------------------------------------------------------

stop_daemons() {
  # Kill host proxy first (clean shutdown before VM dies)
  if [[ -f "$HOST_PROXY_PIDFILE" ]]; then
    echo "Stopping host_proxy..."
    kill "$(cat "$HOST_PROXY_PIDFILE" 2>/dev/null)" 2>/dev/null || true
    rm -f "$HOST_PROXY_PIDFILE"
  fi

  # Kill all remaining daemons via pidfiles
  local pidfile pname
  while IFS= read -r pidfile; do
    pname="$(basename "$pidfile" .pid)"
    echo "Stopping $pname..."
    kill "$(cat "$pidfile" 2>/dev/null)" 2>/dev/null || true
    rm -f "$pidfile"
    sleep 1
  done < <(instance_pidfiles "$INSTANCE_HOME")

  rm -f "$FS_SOCK"
}

_stop(){
  if [[ -d "$INSTANCE_HOME" ]]; then
    stop_daemons
  fi
}

#--------------------------------------------------------------------------------
# CLEAN
#--------------------------------------------------------------------------------

clean_session_files() {
  for file in "$SESSION_IMAGE" "$OVMF_VARS_COPY"; do
    if [[ -f "$file" ]]; then
      echo "Deleting $file"
      rm -f "$file"
      sleep 2
    fi
  done
}

_clean(){
  if [[ -d "$INSTANCE_HOME" ]]; then
    _stop
    clean_session_files
    echo "  Left alone on purpose: $ENV_FILE (LLM_API_KEY, OPENCODE_PASSWORD)."
  fi
}

#--------------------------------------------------------------------------------
# PURGE
#--------------------------------------------------------------------------------

delete_sandbox_dir() {
  echo "Deleting entire sandbox directory $SANDBOX_HOME"
  rm -rfv "$SANDBOX_HOME"
}

_purge(){
  if [[ -d "$SANDBOX_HOME" ]]; then
    for instance_dir in "$SANDBOX_HOME"/instances/*/; do
      if [[ -d "$instance_dir" ]]; then
        INSTANCE_HOME="$instance_dir"
        _stop
      fi
    done
    INSTANCE_HOME="$SANDBOX_HOME/instances/$INSTANCE_ID"
    delete_sandbox_dir
  fi
  if [[ -f "$ENV_FILE" ]]; then
    echo "  Left alone on purpose: $ENV_FILE (LLM_API_KEY, OPENCODE_PASSWORD)."
    echo "  Delete that file too if this directory should forget those settings."
  fi
  sleep 3
}

#--------------------------------------------------------------------------------
# ENTRYPOINT
#--------------------------------------------------------------------------------

main "$@"
