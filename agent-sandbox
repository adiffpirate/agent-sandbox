# SYNC
#--------------------------------------------------------------------------------

sync_docker() {
  local filter_regex="$1"
  echo "Syncing Docker images to registry at 127.0.0.1:$REGISTRY_LISTEN_PORT..."
  docker images --format '{{.Repository}}:{{.Tag}}' | grep -v '127.0.0.1' | grep -E "$filter_regex" | while read -r img; do
    echo
    echo "Syncing $img"
    local target="127.0.0.1:$REGISTRY_LISTEN_PORT/$img"
    docker tag "$img" "$target"
    docker push "$target"
  done
}

sync_files() {
  local sync_arg="$1"
  local host_path="$sync_arg"
  local vm_path=""

  if [[ "$host_path" == *:* ]]; then
    host_path="${sync_arg%%:*}"
    vm_path="${sync_arg#*:}"
  fi

  [[ -z "$vm_path" ]] && vm_path="$host_path"

  local ssh_user=""
  if [[ "$vm_path" == /home/* ]]; then
    vm_path="/home/$VM_AGENT_USER/${vm_path#/home/*/}"
    ssh_user="$VM_AGENT_USER"
  elif [[ "$vm_path" == /tmp/* ]]; then
    ssh_user="$VM_AGENT_USER"
  else
    ssh_user="root"
  fi

  vm_path="${vm_path%/}"

  if [[ ! -e "$host_path" ]]; then
    echo "ERROR: Path '$host_path' does not exist"
    exit 1
  fi

  if [[ -d "$host_path" ]]; then
    host_path="${host_path%/}/"
  fi

  echo "Syncing $host_path -> $vm_path (rsync incremental)"
  local vm_dir
  vm_dir=$(dirname "$vm_path")
  _ssh root "mkdir -p '$vm_dir'"

  rsync -az --partial \
    -e "ssh -i $SSH_KEY -p $SSH_PORT -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null" \
    "$host_path" "${ssh_user}@127.0.0.1:${vm_path%/}"
}

_sync(){
  local sync_mode="$1"
  local sync_arg="${2:-}"

  if ! is_running qemu; then
    echo "ERROR: VM is not running. Unable to sync"
    exit 1
  fi

  case "$sync_mode" in
    docker) sync_docker "${sync_arg:-.*}" ;;
    file)   sync_files "$sync_arg" ;;
    *)      echo "ERROR: Unknown sync mode '$sync_mode'. Use 'docker' or 'file'."; exit 1 ;;
  esac
}

#--------------------------------------------------------------------------------
# STATUS
#--------------------------------------------------------------------------------

get_pids() {
  local instance_dir="$1"
  local pid_list=""
  for pidfile in "$instance_dir"/*.pid; do
    if [[ -f "$pidfile" ]]; then
      local pname="$(basename "$pidfile" .pid)"
      local pid="$(cat "$pidfile" 2>/dev/null || echo stopped)"
      [[ -n "$pid_list" ]] && pid_list="$pid_list, "
      pid_list="${pid_list}${pname}:${pid}"
    fi
  done
  echo "$pid_list"
}

is_session_active() {
  local instance_dir="$1"
  local has_active=0
  for pidfile in "$instance_dir"/*.pid; do
    if [[ -f "$pidfile" ]]; then
      local pid="$(cat "$pidfile" 2>/dev/null)"
      if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        has_active=1
        break
      fi
    fi
  done
  return $((1 - has_active))
}

_status(){
  if [[ ! -d "$SANDBOX_HOME/instances" ]]; then
    echo "No sessions found."
    return
  fi

  local found=0
  local max_id_len=7
  local -a lines=()

  for instance_dir in "$SANDBOX_HOME"/instances/*/; do
    if [[ ! -d "$instance_dir" ]]; then
      continue
    fi
    found=1
    local session_id="$(basename "$instance_dir")"
    local instance_path=""
    if [[ -f "$instance_dir/.instance_path" ]]; then
      instance_path="$(cat "$instance_dir/.instance_path")"
    else
      instance_path="(unknown)"
    fi
    local pids
    pids="$(get_pids "$instance_dir")"
    if [[ ${#session_id} -gt $max_id_len ]]; then max_id_len=${#session_id}; fi
    lines+=("$session_id|$instance_path|$pids|$instance_dir")
  done

  if [[ "$found" -eq 0 ]]; then
    echo "No sessions found."
    return
  fi

  printf "\n"
  printf "%-${max_id_len}s  %-4s  %-40s  %s\n" "SESSION" "STATUS" "PATH" "PIDS"
  local sep_id sep_status sep_path sep_pids
  sep_id="$(printf '%*s' "$max_id_len" '' | tr ' ' '-')"
  sep_status="$(printf '%*s' 4 '' | tr ' ' '-')"
  sep_path="$(printf '%*s' 40 '' | tr ' ' '-')"
  sep_pids="$(printf '%*s' 40 '' | tr ' ' '-')"
  printf "%s  %s  %s  %s\n" "$sep_id" "$sep_status" "$sep_path" "$sep_pids"

  for line in "${lines[@]}"; do
    local session_id="${line%%|*}"
    local rest="${line#*|}"
    local display_path="${rest%%|*}"
    rest="${rest#*|}"
    local pids="${rest%%|*}"
    local instance_dir="${rest##*|}"

    local status_display
    if is_session_active "$instance_dir"; then
      status_display="on"
    else
      status_display="off"
    fi

    local pid_display="${pids:--}"
    printf "%-${max_id_len}s  %-4s  %-40s  %s\n" "$session_id" "$status_display" "$display_path" "$pid_display"
  done

  printf "\n"
}

