stop_daemons() {
  # Kill host proxy first (clean shutdown before VM dies)
  if [[ -f "$HOST_PROXY_PIDFILE" ]]; then
    echo "Stopping host_proxy..."
    kill "$(cat "$HOST_PROXY_PIDFILE" 2>/dev/null)" 2>/dev/null || true
    rm -f "$HOST_PROXY_PIDFILE"
  fi

  # Kill all remaining daemons via pidfiles
  find "$INSTANCE_HOME" -name '*.pid' | while read pidfile; do
    local pname
    pname="$(basename "$pidfile" .pid)"
    echo "Stopping $pname..."
    kill "$(cat "$pidfile" 2>/dev/null)" 2>/dev/null || true
    rm -f "$pidfile"
    sleep 1
  done

  rm -f "$AGENT_ALIVE"
  rm -f "$FS_SOCK"
}

_stop(){
  if [[ -d "$INSTANCE_HOME" ]]; then
    stop_daemons
  fi
}

