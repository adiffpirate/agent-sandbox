#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE_EOF'
Usage:
  agent-sandbox run [--model <model>] [--context-size <size>] [--vm-memory <size>] [--vm-threads <count>] [--local-llm-host <ip>] [--local-llm-port <port>] [--restrict-network on|off] [--dns-whitelist <domains>] [--workdir-ro] (requires prior 'build')
  agent-sandbox ssh <user> <command>
  agent-sandbox build <extra_command>
  agent-sandbox sync docker [filter_regex]
  agent-sandbox sync file <host_path>[:<vm_path>]
  agent-sandbox status
  agent-sandbox stop
  agent-sandbox clean
  agent-sandbox purge

The only agent this tool runs is OpenCode V2, as a systemd service inside the VM.

Run options:
  --model <model>            Model to use. Default: code
  --context-size <size>      Maximum context window for opencode (half for output limit). Default: 124000
  --vm-memory <size>         VM RAM (e.g. 4G, 8G). Default: 4G
  --vm-threads <count>       VM CPU threads. Default: 80% of host threads
  --local-llm-host <ip>      LLM address on the host. Default: 192.168.0.210 (or $LOCAL_LLM_HOST)
  --local-llm-port <port>    Host port for LLM proxy. Default: 8080
  --restrict-network on|off  Restrict VM network. Default: on
  --dns-whitelist <domains>  Comma-separated list of allowed domains.
                             When provided with --restrict-network on, enables fine-grained
                             domain whitelist via in-VM transparent proxy + host CONNECT proxy.
                             Without it, --restrict-network on simply blocks all external traffic.
                             Subdomain matching is automatic: "github.com" allows "api.github.com".
                             Example: --dns-whitelist github.com,npmjs.org,pypi.org
  --workdir-ro               Mount workdir as read-only in the VM

  NOTE: Running 'run' on an already-active instance will stop and restart it
        with the new flags (useful for toggling --workdir-ro, --dns-whitelist, etc).

Build options:
  --vm-memory <size>         VM RAM (e.g. 4G, 8G). Default: 4G
  --vm-threads <count>       VM CPU threads. Default: 80% of host threads
  --local-llm-host <ip>      LLM address on the host. Default: 192.168.0.210 (or $LOCAL_LLM_HOST)
  --local-llm-port <port>    Host port for LLM proxy. Default: 8080

Environment overrides:
  OPENCODE_VERSION           Pin the OpenCode V2 version (default: latest)
  OPENCODE_TARGET            Platform package (default: cli-linux-x64).
                             Use cli-linux-x64-baseline on CPUs without AVX2.
  EXTRA_PACKAGES             Space-separated apt packages to add to the golden image
USAGE_EOF
  exit 1
}

#--------------------------------------------------------------------------------
# GLOBAL VARIABLES (shared across all instances)
#--------------------------------------------------------------------------------

SANDBOX_HOME="$HOME/.local/share/agent-sandbox"
BASE_IMAGE="$SANDBOX_HOME/vm-base-image.qcow2"
GOLDEN_IMAGE="$SANDBOX_HOME/vm-golden-image.qcow2"
SEED_ISO="$SANDBOX_HOME/seed.iso"
USER_DATA="$SANDBOX_HOME/user-data"
META_DATA="$SANDBOX_HOME/meta-data"
SSH_KEY="$SANDBOX_HOME/agent-sandbox_ed25519"
SSH_PUB="$SSH_KEY.pub"
OVMF_CODE_COPY="$SANDBOX_HOME/OVMF_CODE.fd"
# Ubuntu Minimal 24.04 LTS cloud image (glibc + systemd, cloud-init ready, ~248 MB).
# "Minimal" is Ubuntu's small-footprint cloud flavour: cloud-init, openssh-server,
# python3, netplan, linux-image-virtual, and nothing a human would log in with.
# Swap "noble" for "resolute" here if you want the 26.04 LTS base instead.
DOWNLOAD_IMAGE="https://cloud-images.ubuntu.com/minimal/releases/noble/release/ubuntu-24.04-minimal-cloudimg-amd64.img"
# Optional firmware overrides: OVMF_CODE_SOURCE=/path/to/CODE.fd
# OVMF_VARS_SOURCE=/path/to/VARS.fd. Left empty, the script picks the
# Debian/Ubuntu split pair itself. Do not point both at one combined image:
# without a separate writable variable store EDK2 falls back to putting its
# 'NvVars' file on the first filesystem it can write to, which is the shared
# workdir (see uefi_pflash_args).
OVMF_CODE_SOURCE="${OVMF_CODE_SOURCE:-}"
OVMF_VARS_SOURCE="${OVMF_VARS_SOURCE:-}"

# OpenCode V2 release channel (npm-hosted platform packages).
OPENCODE_VERSION="${OPENCODE_VERSION:-}"
OPENCODE_TARGET="${OPENCODE_TARGET:-cli-linux-x64}"
OPENCODE_METADATA_URL="https://opencode.ai/update/api/latest/cli/npm"

# Extra apt packages for the golden image, e.g. EXTRA_PACKAGES="build-essential python3-pip"
EXTRA_PACKAGES="${EXTRA_PACKAGES:-}"

WORKDIR="$(pwd)"

#--------------------------------------------------------------------------------
# PER-INSTANCE VARIABLES
#--------------------------------------------------------------------------------

INSTANCE_ID="inst-$(echo -n "$WORKDIR" | sha256sum | head -c 8)"
INSTANCE_HOME="$SANDBOX_HOME/instances/$INSTANCE_ID"

INSTANCE_PORT_OFFSET=$(( 16#$(echo -n "$INSTANCE_ID" | md5sum | head -c 4) % 1000 ))

SSH_PORT=$((2222 + INSTANCE_PORT_OFFSET))

HAPROXY_LISTEN_PORT=$((11434 + INSTANCE_PORT_OFFSET))
LOCAL_LLM_HOST="${LOCAL_LLM_HOST:-192.168.0.210}"
LOCAL_LLM_SERVER_PORT="8080"

REGISTRY_LISTEN_PORT=$((5000 + INSTANCE_PORT_OFFSET))
REGISTRY_ENDPOINT="10.0.2.100:5000"
# The registry binary normally lives in /usr/local/bin; allow a user-local copy.
REGISTRY_BIN="${REGISTRY_BIN:-$(command -v registry 2>/dev/null || echo "$HOME/.local/bin/registry")}"

SESSION_IMAGE="$INSTANCE_HOME/vm-session-disk.qcow2"
OVMF_VARS_COPY="$INSTANCE_HOME/OVMF_VARS.fd"
FS_SOCK="$INSTANCE_HOME/virtiofsd.sock"
QEMU_PIDFILE="$INSTANCE_HOME/qemu.pid"
QEMU_LOG="$INSTANCE_HOME/qemu.log"
VIRTIOFSD_PIDFILE="$INSTANCE_HOME/virtiofsd.pid"
VIRTIOFSD_LOG="$INSTANCE_HOME/virtiofsd.log"
HAPROXY_CONFIG="$INSTANCE_HOME/haproxy.conf"
HAPROXY_PIDFILE="$INSTANCE_HOME/haproxy.pid"
HAPROXY_LOG="$INSTANCE_HOME/haproxy.log"
REGISTRY_CONFIG="$INSTANCE_HOME/registry.conf"
REGISTRY_PIDFILE="$INSTANCE_HOME/registry.pid"
REGISTRY_LOG="$INSTANCE_HOME/registry.log"
REGISTRY_DIR="$INSTANCE_HOME/registry"
# The settings file the user edits: LLM_API_KEY and OPENCODE_PASSWORD. It lives in
# the directory 'run' was invoked from, which is also what the VM sees as
# /home/agent/workdir, so it is read (and created) on every run: edit it, rerun.
ENV_FILE="$WORKDIR/.env"
# Where older releases kept the generated password; migrated into $ENV_FILE once.
LEGACY_ENV_FILE="$INSTANCE_HOME/opencode.env"
# Values read from $ENV_FILE on every run.
LLM_API_KEY=""
OPENCODE_PASSWORD=""
# Non-loopback address OpenCode reports for itself inside the VM; used by the
# connect instructions ('run' never prints the loopback address).
OPENCODE_GUEST_URL=""
# Records which base image + OpenCode version the golden image was built against.
IMAGE_STAMP="$SANDBOX_HOME/vm-image.stamp"
# Printed to the guest console by the last runcmd step; 'build' requires it.
PROVISION_SENTINEL="agent-sandbox-provision-ok"
# Guard against a guest that never powers itself off.
BUILD_TIMEOUT="${BUILD_TIMEOUT:-2400}"

# Host-side proxy (handles HTTP/HTTPS + DNS, per-instance)
HOST_PROXY_PORT=$((14000 + INSTANCE_PORT_OFFSET))
HOST_PROXY_SCRIPT="$INSTANCE_HOME/host_proxy.py"
HOST_PROXY_PIDFILE="$INSTANCE_HOME/host_proxy.pid"
HOST_PROXY_LOG="$INSTANCE_HOME/host_proxy.log"
# Whitelist
WHITELIST_FILE="$INSTANCE_HOME/dns-whitelist.txt"

# LAN-facing OpenCode port. HAProxy owns this port on the host.
OPENCODE_WEB_PORT=$((9090 + INSTANCE_PORT_OFFSET))

# QEMU-only OpenCode port. This is intentionally bound to localhost on the host
# and is never exposed directly to the LAN through QEMU hostfwd.
OPENCODE_VM_PORT=$((19090 + INSTANCE_PORT_OFFSET))

# VM internals
VM_NAME="agent-sandbox-$INSTANCE_ID"
VM_DISK_SIZE="20G"
# QEMU acceleration: kvm by default, "tcg" for hosts without /dev/kvm access.
SANDBOX_ACCEL="${SANDBOX_ACCEL:-kvm}"
# "-cpu host" is invalid under TCG, where "max" is the closest equivalent.
if [[ -z "${VM_CPU_MODEL:-}" ]]; then
  if [[ "$SANDBOX_ACCEL" == "kvm" ]]; then VM_CPU_MODEL="host"; else VM_CPU_MODEL="max"; fi
fi

VM_MEMORY_RAM="4G"
VM_THREADS=$(( $(nproc 2>/dev/null || echo 4) * 80 / 100 ))
[[ "$VM_THREADS" -lt 1 ]] && VM_THREADS=4
VM_RESTRICT_NETWORK="on"
VM_WORKDIR_RO="off"
VM_AGENT_USER="agent"
VM_AGENT_WORKDIR="/home/$VM_AGENT_USER/workdir"
# The guest ids virtiofsd maps onto the host user running this script. The golden
# image pins the agent account to exactly these ids, so shared files land on the
# host owned by whoever started the sandbox. Change both together if 1001/1002
# collide with something in a custom image.
VM_AGENT_UID="${VM_AGENT_UID:-1001}"
VM_AGENT_GID="${VM_AGENT_GID:-1002}"

CMD_DEFAULT_MODEL="code"
CMD_DEFAULT_CONTEXT_SIZE=124000

#--------------------------------------------------------------------------------
# MAIN
#--------------------------------------------------------------------------------

main() {
  if [[ $# -eq 0 ]]; then
    usage
  fi

  local subcommand="$1"
  shift || true

  case "$subcommand" in
    build)
      local cmd=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --vm-memory)     VM_MEMORY_RAM="$2"; shift 2 ;;
          --vm-threads)    VM_THREADS="$2"; shift 2 ;;
          --local-llm-host) LOCAL_LLM_HOST="$2"; shift 2 ;;
          --local-llm-port) LOCAL_LLM_SERVER_PORT="$2"; shift 2 ;;
          --)              shift; cmd="$*"; break ;;
          *)               cmd="$*"; break ;;
        esac
      done
      _build "$cmd"
      ;;
    run)
      local model="$CMD_DEFAULT_MODEL"
      local vm_memory="$VM_MEMORY_RAM"
      local vm_threads="$VM_THREADS"
      local local_llm_host="$LOCAL_LLM_HOST"
      local local_llm_server_port="$LOCAL_LLM_SERVER_PORT"
      local context_size="$CMD_DEFAULT_CONTEXT_SIZE"
      local restrict_network="$VM_RESTRICT_NETWORK"
      local workdir_ro="$VM_WORKDIR_RO"
      local dns_whitelist=""

      while [[ $# -gt 0 ]]; do
        case "$1" in
          --model) model="$2"; shift 2 ;;
          --context-size) context_size="$2"; shift 2 ;;
          --vm-memory) vm_memory="$2"; shift 2 ;;
          --vm-threads) vm_threads="$2"; shift 2 ;;
          --local-llm-host) local_llm_host="$2"; shift 2 ;;
          --local-llm-port) local_llm_server_port="$2"; shift 2 ;;
          --restrict-network) restrict_network="$2"; shift 2 ;;
          --workdir-ro) workdir_ro="on"; shift ;;
          --dns-whitelist) dns_whitelist="$2"; shift 2 ;;
          *) usage ;;
        esac
      done

      VM_MEMORY_RAM="$vm_memory"
      VM_THREADS="$vm_threads"
      LOCAL_LLM_HOST="$local_llm_host"
      LOCAL_LLM_SERVER_PORT="$local_llm_server_port"
      VM_RESTRICT_NETWORK="$restrict_network"
      VM_WORKDIR_RO="$workdir_ro"
      _run "$model" "$context_size" "$dns_whitelist"
      ;;
    ssh)
      local user="${1:-$VM_AGENT_USER}"
      shift || true
      local cmd="${*:-bash}"
      _ssh "$user" "$cmd"
      ;;
    status)
      _status
      ;;
    sync)
      local sync_mode="${1:-docker}"
      shift || true
      local sync_arg="${1:-}"
      _sync "$sync_mode" "$sync_arg"
      ;;
    stop)
      _stop
      ;;
    clean)
      _clean
      ;;
    purge)
      _purge
      ;;
    *)
      usage
      ;;
  esac
}

#--------------------------------------------------------------------------------
# UTILS
#--------------------------------------------------------------------------------

have_cmd() {
  command -v "$1" >/dev/null 2>&1
}

virtiofsd_bin() {
  if have_cmd virtiofsd; then
    command -v virtiofsd
  elif [[ -x /usr/libexec/virtiofsd ]]; then
    echo /usr/libexec/virtiofsd
  elif [[ -x /usr/lib/qemu/virtiofsd ]]; then
    echo /usr/lib/qemu/virtiofsd
  else
    return 1
  fi
}

is_running(){
  local daemon=$1
  local pidfile
  pidfile="$(pidfile_for "$daemon")"
  [[ -f "$pidfile" ]] || return 1

  local pid
  pid="$(cat "$pidfile" 2>/dev/null)"
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    return 0
  fi

  # A pidfile whose process is gone would otherwise make 'run' skip starting
  # the daemon it refers to.
  rm -f "$pidfile"
  return 1
}

pidfile_for(){
  case "$1" in
    virtiofsd)   echo "$VIRTIOFSD_PIDFILE" ;;
    haproxy)     echo "$HAPROXY_PIDFILE" ;;
    registry)    echo "$REGISTRY_PIDFILE" ;;
    qemu)        echo "$QEMU_PIDFILE" ;;
    host_proxy)  echo "$HOST_PROXY_PIDFILE" ;;
    *)           echo "$INSTANCE_HOME/$1.pid" ;;
  esac
}

# Pidfiles are named after the daemon that wrote them. One left behind by an
# older version of this script (virtiofsd's was renamed) would otherwise show up
# as a second phantom daemon in 'status' and be killed twice by 'stop', so the
# same process recorded under two names collapses to one entry.
instance_pidfiles() {
  local instance_dir="$1"
  local pidfile pid seen=""
  for pidfile in "$instance_dir"/*.pid; do
    [[ -f "$pidfile" ]] || continue
    pid="$(cat "$pidfile" 2>/dev/null)"
    if [[ -n "$pid" && " $seen " == *" $pid "* ]]; then
      rm -f "$pidfile"
      continue
    fi
    seen="$seen $pid"
    echo "$pidfile"
  done
}

# Seed ISO builder: genisoimage/mkisofs are deprecated aliases on modern Ubuntu,
# where xorriso provides the same behaviour with "-as mkisofs".
iso_tool() {
  if have_cmd genisoimage; then
    echo "genisoimage"
  elif have_cmd mkisofs; then
    echo "mkisofs"
  elif have_cmd xorriso; then
    echo "xorriso -as mkisofs"
  else
    return 1
  fi
}

build_seed_iso() {
  local tool
  if ! tool="$(iso_tool)"; then
    echo "ERROR: no ISO tool available. Install one of: genisoimage, mkisofs, xorriso." >&2
    exit 1
  fi
  # shellcheck disable=SC2086  # "xorriso -as mkisofs" must stay word-split
  $tool -output "$SEED_ISO" -volid cidata -rock "$USER_DATA" "$META_DATA" >/dev/null
}

random_password() {
  # 48 lowercase hex chars: YAML/shell safe, fixed length, and no SIGPIPE under
  # pipefail (od exits on its own; tr reads to EOF).
  od -An -tx1 -N 24 /dev/urandom | tr -d ' \n'
}

# Resolve the OpenCode V2 version once per build, then pin it into the golden image.
resolve_opencode_version() {
  if [[ -n "$OPENCODE_VERSION" ]]; then
    echo "$OPENCODE_VERSION"
    return
  fi
  local meta
  meta="$(curl -fsSL --max-time 30 "$OPENCODE_METADATA_URL" 2>/dev/null || true)"
  local version
  version="$(sed -n 's/.*"version":"\([^"]*\)".*/\1/p' <<< "$meta")"
  if [[ -z "$version" ]]; then
    echo "ERROR: Could not resolve the latest OpenCode version from $OPENCODE_METADATA_URL" >&2
    echo "       Pin it with OPENCODE_VERSION=<version> and retry." >&2
    exit 1
  fi
  echo "$version"
}

#--------------------------------------------------------------------------------
# PRE REQUISITES
#--------------------------------------------------------------------------------

ensure_prereqs() {
  ensure_packages
  ensure_global_dirs
  ensure_instance_dirs
  ensure_ssh_key
  ensure_uefi
}

ensure_packages() {
  local missing=0

  for c in "curl" "ssh" "ssh-keygen" "qemu-system-x86_64" "qemu-img" "newuidmap" "nc" "haproxy" "socat" "rsync" "python3"; do
    if ! have_cmd "$c"; then
      echo "Missing command: $c" >&2
      missing=1
    fi
  done

  if [[ ! -x "$REGISTRY_BIN" ]]; then
    echo "Missing binary: OCI registry ($REGISTRY_BIN)" >&2
    missing=1
  fi

  if ! iso_tool >/dev/null 2>&1; then
    echo "Missing command: genisoimage, mkisofs or xorriso (needed to build the cloud-init seed)" >&2
    missing=1
  fi

  if ! virtiofsd_bin >/dev/null 2>&1; then
    echo "Missing command: virtiofsd" >&2
    missing=1
  fi

  if ! uefi_find_code >/dev/null 2>&1; then
    echo "Missing UEFI firmware: install 'ovmf' (or set OVMF_CODE_SOURCE/OVMF_VARS_SOURCE)" >&2
    missing=1
  fi

  if [[ "$SANDBOX_ACCEL" == "kvm" ]]; then
    if [[ ! -e /dev/kvm ]]; then
      echo "Missing /dev/kvm (KVM not available). Set SANDBOX_ACCEL=tcg to run emulated." >&2
      missing=1
    elif [[ ! -r /dev/kvm || ! -w /dev/kvm ]]; then
      echo "No permission to use /dev/kvm (are you in the kvm group?)" >&2
      echo "  sudo usermod -aG kvm $USER   # then start a new shell" >&2
      echo "  or run with SANDBOX_ACCEL=tcg" >&2
      missing=1
    fi
  fi

  if [[ "$missing" -ne 0 ]]; then
    cat >&2 <<'EOF'
Install prerequisites:
  sudo apt install -y curl openssh-client xorriso qemu-system-x86 qemu-utils virtiofsd uidmap ovmf moreutils haproxy socat rsync python3

  # OCI registry, system-wide...
  curl -L https://github.com/distribution/distribution/releases/download/v3.1.0/registry_3.1.0_linux_amd64.tar.gz -o /tmp/registry.tar.gz
  tar -xzf /tmp/registry.tar.gz -C "/tmp" && sudo install -m 0755 /tmp/registry /usr/local/bin/registry
  # ...or per-user, no sudo (the script also looks in ~/.local/bin/registry):
  #   mkdir -p ~/.local/bin && tar -xzf /tmp/registry.tar.gz -C ~/.local/bin registry

Ensure KVM is enabled:
  - BIOS/UEFI virtualization (Intel VT-x / AMD-V)
  - Kernel module loaded (kvm, kvm_intel or kvm_amd)
  - User in kvm group: sudo usermod -aG kvm $USER
  - On WSL2: https://serverfault.com/a/1115773
EOF
    exit 1
  fi
}

ensure_global_dirs() {
  mkdir -p "$SANDBOX_HOME"
}

ensure_instance_dirs() {
  mkdir -p "$INSTANCE_HOME"
  echo -n "$WORKDIR" > "$INSTANCE_HOME/.instance_path"
}

ensure_uefi() {
  local code vars

  # A running QEMU maps these files into the guest, so rewriting them under it
  # would corrupt its firmware and variable store.
  if is_running qemu; then
    return 0
  fi

  if ! code="$(uefi_find_code)"; then
    echo "ERROR: no UEFI firmware found. Debian/Ubuntu's 'ovmf' package provides" >&2
    echo "       /usr/share/OVMF/OVMF_CODE_4M.fd + OVMF_VARS_4M.fd, or set" >&2
    echo "       OVMF_CODE_SOURCE/OVMF_VARS_SOURCE to firmware files of your choice." >&2
    exit 1
  fi
  vars="$(uefi_find_vars)" || vars=""

  _sync_firmware "$code" "$OVMF_CODE_COPY"
  if [[ -n "$vars" ]]; then
    _sync_firmware "$vars" "$OVMF_VARS_COPY"
  else
    # Only a combined image is available: it becomes the single writable drive.
    rm -f "$OVMF_VARS_COPY"
  fi
}

# Keep the private firmware copies in step with their sources rather than reusing
# whatever is lying around: a leftover from a different firmware package (or from
# an older release of this script) would otherwise boot every VM with the wrong
# variable store.
_sync_firmware() {
  local src="$1" dest="$2"
  if [[ -f "$dest" ]] && cmp -s "$src" "$dest"; then
    return 0
  fi
  cp -f -- "$src" "$dest"
}

# The -drive arguments that attach the firmware, one per line. Split images
# (Debian/Ubuntu) want the code image read-only and the variable-store copy
# writable; a combined image has to be attached writable as a single drive
# instead. If EDK2 has no writable variable store it falls back to an 'NvVars'
# file on the first filesystem it can write to, and a VM's firmware can see the
# virtiofs share, so that file would end up in the user's project directory.
uefi_pflash_args() {
  if [[ -f "$OVMF_VARS_COPY" ]]; then
    printf '%s\n' \
      "-drive" "if=pflash,format=raw,readonly=on,file=$OVMF_CODE_COPY" \
      "-drive" "if=pflash,format=raw,file=$OVMF_VARS_COPY"
  else
    printf '%s\n' "-drive" "if=pflash,format=raw,file=$OVMF_CODE_COPY"
  fi
}

# Debian/Ubuntu split the firmware into CODE + VARS files under /usr/share/OVMF,
# while Alpine/openSUSE ship a single combined OVMF.fd used for both pflash drives.
uefi_find_code() {
  local candidate
  for candidate in \
    "${OVMF_CODE_SOURCE:-}" \
    /usr/share/OVMF/OVMF_CODE_4M.fd \
    /usr/share/OVMF/OVMF_CODE.fd \
    /usr/share/qemu/OVMF_CODE_4M.fd \
    /usr/share/edk2/ovmf/OVMF_CODE_4M.fd \
    /usr/share/ovmf/OVMF_CODE.fd \
    /usr/share/ovmf/OVMF.fd
  do
    [[ -n "$candidate" && -r "$candidate" ]] && { echo "$candidate"; return 0; }
  done
  return 1
}

uefi_find_vars() {
  local candidate
  for candidate in \
    "${OVMF_VARS_SOURCE:-}" \
    /usr/share/OVMF/OVMF_VARS_4M.fd \
    /usr/share/OVMF/OVMF_VARS.fd \
    /usr/share/qemu/OVMF_VARS_4M.fd \
    /usr/share/edk2/ovmf/OVMF_VARS_4M.fd \
    /usr/share/ovmf/OVMF_VARS.fd
  do
    [[ -n "$candidate" && -r "$candidate" ]] && { echo "$candidate"; return 0; }
  done
  return 1
}

ensure_ssh_key() {
  if [[ ! -f "$SSH_KEY" ]]; then
    ssh-keygen -t ed25519 -N "" -f "$SSH_KEY" >/dev/null
  fi
}

#--------------------------------------------------------------------------------
# BUILD (global operation)
#--------------------------------------------------------------------------------

download_base_image() {
  if [[ ! -f "$BASE_IMAGE" ]]; then
    echo "Downloading base image from $DOWNLOAD_IMAGE"
    curl -L --fail --progress-bar "$DOWNLOAD_IMAGE" -o "$BASE_IMAGE"
    # "QFI\xfb" = qcow2 magic. Fail loudly instead of confusing qemu-img later.
    if [[ "$(od -An -tx1 -N4 "$BASE_IMAGE" | tr -d ' ')" != "514649fb" ]]; then
      echo "ERROR: $BASE_IMAGE is not a qcow2 image (unexpected magic)." >&2
      echo "       Delete it and re-run 'agent-sandbox build'." >&2
      rm -f "$BASE_IMAGE"
      exit 1
    fi
    chmod -w "$BASE_IMAGE"
  fi
}

create_cloud_init() {
  local extra_cmd="$1"
  local version="$2"
  local root_password="$3"

  local custom_ca_config=""
  if ls /usr/local/share/ca-certificates/*.crt >/dev/null 2>&1; then
    custom_ca_config="bootcmd:\n  - [ cloud-init-per, instance, setup-ca, sh, -c, \"update-ca-certificates\" ]\n\n"
    custom_ca_config+="ca_certs:\n  trusted:"
    for cert in /usr/local/share/ca-certificates/*.crt; do
      custom_ca_config+="\n    - |\n$(sed 's/^/      /' "$cert")"
    done
  fi

  # EXTRA_PACKAGES is intentionally word-split into a YAML sequence.
  local extra_packages=""
  for pkg in $EXTRA_PACKAGES; do
    extra_packages+="  - $pkg"$'\n'
  done

  cat >"$USER_DATA" <<EOF
#cloud-config

$(echo -e "$custom_ca_config")

package_update: true
package_upgrade: false
apt:
  conf: |
    Acquire::Retries "5";
    Acquire::http::Pipeline-Depth "0";
    Apt::Install-Recommends "false";
    Apt::AutoRemove::RecommendsImportant "false";
packages:
  - git
  - rsync
  - nftables
  - ripgrep
  - vim-tiny
  - apparmor
  - docker.io
$(echo -e "$extra_packages")
# Nothing else. The golden image stays lean: no build toolchain, no python3-dev,
# no node. Add what a project needs with EXTRA_PACKAGES="build-essential python3-pip".

# Neutralise the image's built-in default user; $VM_AGENT_USER is defined explicitly below.
system_info:
  default_user:
    name: ubuntu
    lock_passwd: true
    shell: /usr/sbin/nologin
    groups: []

users:
  - name: root
    lock_passwd: false
    ssh_authorized_keys:
      - $(cat "$SSH_PUB")
  - name: $VM_AGENT_USER
    shell: /bin/bash
    lock_passwd: false
    ssh_authorized_keys:
      - $(cat "$SSH_PUB")

runcmd:
  # cloud-init runs this file with /bin/sh, which is dash on Ubuntu, so stay
  # POSIX: 'set -o pipefail' is a bashism that would abort the whole script.
  - set -eux
  # --- The one agent: OpenCode V2 (glibc build, no node/npm runtime needed) ---
  - curl -fsSL --retry 5 -o /tmp/opencode.tgz "https://registry.npmjs.org/@opencode%2f$OPENCODE_TARGET/-/$OPENCODE_TARGET-$version.tgz"
  - tar -xzf /tmp/opencode.tgz -C /tmp
  - install -m 0755 /tmp/package/bin/opencode /usr/local/bin/opencode
  - rm -rf /tmp/opencode.tgz /tmp/package
  - opencode --version
  # --- Slim down the base image ---
  - apt-get purge -y --auto-remove snapd || true
  - rm -rf /snap /var/snap /var/lib/snapd /var/cache/snapd /etc/systemd/system/snapd.service.d /etc/apparmor.d/snap*
  - apt-get autoremove --purge -y || true
  - apt-get clean
  - rm -rf /var/lib/apt/lists/*
  # --- Keep the image's own default user unusable, if the base image has one ---
  - usermod -L -s /usr/sbin/nologin ubuntu || true
  # --- Pin the agent account to the ids virtiofsd maps onto the host user ---
  # cloud-init assigns the first free ids, which vary by base image; the shared
  # workdir only works when the guest ids match virtiofsd's uid/gid maps.
  - getent group $VM_AGENT_USER || groupadd -g $VM_AGENT_GID $VM_AGENT_USER
  - groupmod -g $VM_AGENT_GID $VM_AGENT_USER
  - usermod -u $VM_AGENT_UID $VM_AGENT_USER
  - chown -R $VM_AGENT_UID:$VM_AGENT_GID /home/$VM_AGENT_USER
  - id $VM_AGENT_USER
  - test "\$(id -u $VM_AGENT_USER)" = "$VM_AGENT_UID" && test "\$(id -g $VM_AGENT_USER)" = "$VM_AGENT_GID"
  # --- Docker, reachable by the agent user through the socket group ---
  # The group is created by the docker.io package, so this runs after the
  # package install step of the same cloud-init pass.
  - getent group docker || groupadd -r docker
  - usermod -aG docker $VM_AGENT_USER
  - systemctl enable docker
  # Install docker wrapper to force images be pulled from local registry
  - mv "\$(which docker)" /usr/bin/docker.real
  - curl -L https://github.com/adiffpirate/docker-wrapper-custom-registry/raw/refs/heads/main/docker.py -o /usr/local/bin/docker
  - chmod +x /usr/local/bin/docker
  # Disable GRUB timeout so VM boots instantly
  - sed -i 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=0/' /etc/default/grub
  - echo 'GRUB_TIMEOUT_STYLE=hidden' >> /etc/default/grub
  - grub-mkconfig -o /boot/grub/grub.cfg
  # --- Share the workdir automatically, even after a guest reboot ---
  # 'nofail' keeps booting alive if the virtiofs device is ever absent.
  - mkdir -p /home/$VM_AGENT_USER/workdir
  - grep -q 'virtiofs' /etc/fstab || echo 'workdir /home/$VM_AGENT_USER/workdir virtiofs nofail 0 0' >> /etc/fstab
  # Disable cloud-init for future boots
  - touch /etc/cloud/cloud-init.disabled
  - sync
  # Run extra cmd
  - bash -c '$extra_cmd'
  # Reaching this line means every step above succeeded. 'build' greps the
  # serial log for this marker; the guest console is the serial port.
  - echo $PROVISION_SENTINEL > /dev/console

chpasswd:
  expire: false
  list: |
    root:$root_password
    $VM_AGENT_USER:$VM_AGENT_USER

ssh_pwauth: false

write_files:
  - path: /etc/bash.bashrc
    append: true
    content: |
      if [ -f /etc/environment ]; then
        set -a
        . /etc/environment
        set +a
      fi
  - path: /etc/ssh/sshd_config.d/99-hardening.conf
    permissions: '0644'
    content: |
      PermitRootLogin prohibit-password
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PubkeyAuthentication yes
      AuthenticationMethods publickey
      AllowUsers $VM_AGENT_USER root
      MaxAuthTries 3
      LoginGraceTime 20
      AllowTcpForwarding no
      PermitTunnel no
      X11Forwarding no
      ClientAliveInterval 300
      ClientAliveCountMax 2
  - path: /etc/systemd/journald.conf.d/00-volatile.conf
    permissions: '0644'
    content: |
      [Journal]
      Storage=volatile
      SystemMaxUse=64M
  - path: /etc/docker/daemon.json
    content: |
      {
        "insecure-registries": ["$REGISTRY_ENDPOINT"]
      }

# Always power off: 'build' decides success from the marker in the serial log.
# A condition here would leave QEMU running forever on any cloud-init warning,
# because the guest logs always contain the word "Error".
power_state:
  mode: poweroff
  message: "agent-sandbox: powering off the provisioning VM"

final_message: |
  agent-sandbox: cloud-init reached its final stage.
  If "$PROVISION_SENTINEL" is missing from the console log, provisioning failed:
  investigate the cloud-init logs shown above.
EOF

  cat >"$META_DATA" <<EOF
instance-id: agent-sandbox
local-hostname: agent-sandbox
EOF

  build_seed_iso
}

build_golden_image() {
  local serial_log="$SANDBOX_HOME/build-serial.log"

  qemu-img create -f qcow2 -b "$BASE_IMAGE" -F qcow2 "$GOLDEN_IMAGE" $VM_DISK_SIZE

  # Headless: cloud-init talks to us over the serial console, and the guest
  # powers itself off at the end of provisioning (see power_state in the seed).
  echo "Provisioning the golden image... cloud-init console log: $serial_log"
  local -a boot=() pflash=()
  if have_cmd timeout; then
    boot=(timeout "$BUILD_TIMEOUT")
  fi
  mapfile -t pflash < <(uefi_pflash_args)
  if [[ ${#pflash[@]} -eq 0 ]]; then
    echo "ERROR: no UEFI firmware to attach to the VM." >&2
    exit 1
  fi
  boot+=(
    qemu-system-x86_64
    -accel "$SANDBOX_ACCEL"
    -cpu "$VM_CPU_MODEL" -smp $VM_THREADS -m $VM_MEMORY_RAM
    -display none -monitor none -serial "file:$serial_log"
    -no-reboot
    "${pflash[@]}"
    -drive file="$GOLDEN_IMAGE",if=virtio,format=qcow2
    -drive file="$SEED_ISO",format=raw
    -device virtio-net-pci,netdev=net0
    -netdev user,id=net0,restrict=off,hostfwd=tcp:127.0.0.1:${SSH_PORT}-:22
  )

  local rc=0
  # Run from the sandbox state dir: QEMU takes relative paths and any stray file
  # (a firmware variable fallback, for instance) from its working directory, and
  # that directory would otherwise be the user's project, which is also what the
  # VM gets to share. Every path passed here is absolute.
  ( cd "$SANDBOX_HOME" && "${boot[@]}" ) || rc=$?
  if [[ $rc -eq 124 || $rc -eq 137 ]]; then
    echo "ERROR: provisioning timed out after ${BUILD_TIMEOUT}s (guest never powered off)." >&2
    echo "       Raise BUILD_TIMEOUT, or read $serial_log for where it stopped." >&2
    rm -f "$GOLDEN_IMAGE"
    exit 1
  elif [[ $rc -ne 0 ]]; then
    echo "ERROR: qemu exited with status $rc during provisioning." >&2
    rm -f "$GOLDEN_IMAGE"
    exit 1
  fi

  # qemu exiting cleanly is not enough: cloud-init can fail and still shut down.
  if ! grep -q "$PROVISION_SENTINEL" "$serial_log" 2>/dev/null; then
    echo "ERROR: cloud-init did not finish provisioning the image." >&2
    echo "       Look for 'Failed to run' / 'Invalid config' lines in:" >&2
    echo "         $serial_log" >&2
    echo "Last console messages:" >&2
    tail -n 25 "$serial_log" 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g; s/^/  /' >&2
    rm -f "$GOLDEN_IMAGE"
    exit 1
  fi

  echo
  echo "Provisioning completed cleanly (found '$PROVISION_SENTINEL')."
  echo "Golden image built at $GOLDEN_IMAGE"
  qemu-img info "$GOLDEN_IMAGE" | sed -n 's/^/  /p'
}

# 'build' has to start from a clean slate, but it keeps the (large) downloaded
# base image: re-fetching 250 MB on every rebuild is pure waste. Use 'purge' to
# throw that away too.
_clean_build_artefacts() {
  local instance_dir
  for instance_dir in "$SANDBOX_HOME"/instances/*/; do
    if [[ -d "$instance_dir" ]]; then
      INSTANCE_HOME="$instance_dir"
      _stop
    fi
  done
  rm -f "$GOLDEN_IMAGE" "$SESSION_IMAGE" "$SEED_ISO" "$USER_DATA" "$META_DATA" \
        "$OVMF_CODE_COPY" "$OVMF_VARS_COPY" "$IMAGE_STAMP" \
        "$SANDBOX_HOME/build-serial.log"
  sleep 1
}

_build() {
  local extra_cmd="$1"
  _clean_build_artefacts
  ensure_prereqs
  download_base_image

  local version root_password
  version="$(resolve_opencode_version)"
  root_password="$(random_password)"

  echo
  echo "Base image : $DOWNLOAD_IMAGE"
  echo "OpenCode   : $OPENCODE_TARGET $version"
  echo "Packages   : git rsync nftables ripgrep vim-tiny apparmor docker.io ${EXTRA_PACKAGES}"
  echo "Root pass  : $root_password"
  echo "             (SSH is key-only; this is for the serial console only)"
  echo

  create_cloud_init "$extra_cmd" "$version" "$root_password"
  build_golden_image

  {
    printf 'base_image=%s\n' "$DOWNLOAD_IMAGE"
    printf 'opencode=%s %s\n' "$OPENCODE_TARGET" "$version"
    printf 'built=%s\n' "$(date -Is)"
  } > "$IMAGE_STAMP"

  clean_session_files
}

#--------------------------------------------------------------------------------
# RUN (per-instance)
#--------------------------------------------------------------------------------

create_session_overlay() {
  if [[ ! -f "$SESSION_IMAGE" ]]; then
    qemu-img create -f qcow2 -b "$GOLDEN_IMAGE" -F qcow2 "$SESSION_IMAGE" $VM_DISK_SIZE
    echo "VM Session Disk Image created at $SESSION_IMAGE"
  fi
}

start_virtiofsd() {
  if is_running virtiofsd; then
    echo "virtiofsd already running, skipping"
    return
  fi

  rm -f "$FS_SOCK"

  echo "Starting virtiofsd..."
  local ro_flag=""
  if [[ "$VM_WORKDIR_RO" == "on" ]]; then
    ro_flag="--readonly"
    echo "  (workdir mounted read-only)"
  fi

  nohup $(virtiofsd_bin) \
    --socket-path="$FS_SOCK" \
    --shared-dir="$WORKDIR" \
    --sandbox namespace \
    --uid-map=":${VM_AGENT_UID}:$(id -u):1:" \
    --gid-map=":${VM_AGENT_GID}:$(id -g):1:" \
    $ro_flag \
    >"$VIRTIOFSD_LOG" 2>&1 &
  echo $! > "$VIRTIOFSD_PIDFILE"

  local tries=50
  while [[ ! -S "$FS_SOCK" ]]; do
    sleep 0.1
    tries=$((tries - 1))
    if [[ "$tries" -le 0 ]]; then
      echo "ERROR: Timeout waiting for virtiofsd socket. See $VIRTIOFSD_LOG" >&2
      exit 1
    fi
  done
}

# Non-loopback IPv4 addresses of this host, used only to print connect URLs.
host_ipv4_addresses() {
  have_cmd ip || return 0
  ip -4 -o addr show scope global 2>/dev/null | awk '{split($4, a, "/"); print a[1]}' | head -3
}

start_haproxy(){
  if is_running haproxy; then
    echo "haproxy already running, skipping"
    return
  fi

  if nc -z "127.0.0.1" $HAPROXY_LISTEN_PORT > /dev/null 2>&1; then
    echo "ERROR: Port $HAPROXY_LISTEN_PORT already in use" >&2
    exit 1
  fi

  echo "Starting haproxy (LLM :$HAPROXY_LISTEN_PORT, OpenCode :$OPENCODE_WEB_PORT)..."

  cat > "$HAPROXY_CONFIG" <<EOF
global
  log stdout format raw local0
  maxconn 256

defaults
  mode http
  log global
  log-format "[%tr] client=%ci:%cp server=%si:%sp method=%HM path=%HU http=%HV status=%ST req_size=%U resp_size=%B term=%tsc conn_retries=%rc srv_queue=%sq backend_queue=%bq actconn=%ac feconn=%fc beconn=%bc srvconn=%sc time_read_headers=%TR time_in_queue=%Tw time_tcp_connect=%Tc time_response=%Tr time_total=%Ta"
  option httpclose
  timeout connect 1s
  timeout client 1m
  timeout server 2m

frontend llm_in
  bind 0.0.0.0:$HAPROXY_LISTEN_PORT
  default_backend llm_out

backend llm_out
  server llm $LOCAL_LLM_HOST:$LOCAL_LLM_SERVER_PORT
  option accept-invalid-http-response

# OpenCode is exposed through HAProxy rather than directly through QEMU's
# SLIRP hostfwd. QEMU listens only on 127.0.0.1:$OPENCODE_VM_PORT, while
# HAProxy publishes the port on every host interface (Basic auth protects it).
frontend opencode_in
  mode tcp
  bind 0.0.0.0:$OPENCODE_WEB_PORT
  default_backend opencode_out

backend opencode_out
  mode tcp
  server opencode 127.0.0.1:$OPENCODE_VM_PORT check
  timeout connect 2s
  timeout server 1h
EOF

  nohup haproxy -f "$HAPROXY_CONFIG" -db -d > "$HAPROXY_LOG" 2>&1 &
  local pid=$!
  echo $pid > "$HAPROXY_PIDFILE"

  local tries=50
  until nc -z "127.0.0.1" $HAPROXY_LISTEN_PORT > /dev/null 2>&1; do
    sleep 1
    tries=$((tries - 1))
    if [[ "$tries" -le 0 ]]; then
      echo "ERROR: Timeout waiting for haproxy. See $HAPROXY_LOG" >&2
      exit 1
    fi
  done
}

start_registry(){
  if is_running registry; then
    echo "registry already running, skipping"
    return
  fi

  if nc -z "127.0.0.1" $REGISTRY_LISTEN_PORT > /dev/null 2>&1; then
    echo "ERROR: Port $REGISTRY_LISTEN_PORT already in use" >&2
    exit 1
  fi

  echo "Starting registry on port $REGISTRY_LISTEN_PORT..."
  mkdir -p "$REGISTRY_DIR"
  cat > "$REGISTRY_CONFIG" <<EOF
version: 0.1
log:
  level: debug
storage:
  filesystem:
    rootdirectory: $REGISTRY_DIR
http:
  addr: :$REGISTRY_LISTEN_PORT
EOF

  nohup "$REGISTRY_BIN" serve "$REGISTRY_CONFIG" > "$REGISTRY_LOG" 2>&1 &
  local pid=$!
  echo $pid > "$REGISTRY_PIDFILE"

  local tries=50
  until nc -z "127.0.0.1" $REGISTRY_LISTEN_PORT > /dev/null 2>&1; do
    sleep 1
    tries=$((tries - 1))
    if [[ "$tries" -le 0 ]]; then
      echo "ERROR: Timeout waiting for registry. See $REGISTRY_LOG" >&2
      exit 1
    fi
  done
}

#--------------------------------------------------------------------------------
# WHITELIST + HOST CONNECT PROXY (per-instance, optional)
#--------------------------------------------------------------------------------

install_whitelist() {
  local csv="$1"

  local -a domains=()
  IFS=',' read -ra domains <<< "$csv"

  {
    for d in "${domains[@]}"; do
      local trimmed
      trimmed="$(echo "$d" | tr -d '[:space:]')"
      [[ -n "$trimmed" ]] && echo "$trimmed"
    done
  } > "$WHITELIST_FILE"

  local count
  count=$(wc -l < "$WHITELIST_FILE")
  echo "  Whitelist: $count domain(s)"
}

start_host_proxy() {
  if is_running host_proxy; then
    echo "Host proxy already running, skipping"
    return
  fi

  if nc -z "127.0.0.1" $HOST_PROXY_PORT > /dev/null 2>&1; then
    echo "ERROR: Port $HOST_PROXY_PORT already in use" >&2
    exit 1
  fi

  echo "Starting host proxy on 127.0.0.1:$HOST_PROXY_PORT (HTTP/HTTPS + DNS)..."

  cat > "$HOST_PROXY_SCRIPT" <<'PYEOF'
#!/usr/bin/env python3
"""Host-side whitelist proxy.
Handles:
  - HTTP/HTTPS: DNAT'd connections from VM. Reads SNI or Host header,
    checks whitelist, tunnels to real server.
  - DNS: connections prefixed with b"DNS" + length + query.
    Forwards to upstream DNS, returns response.
"""
import socket, struct, threading, sys

BIND_ADDR = "127.0.0.1"
BIND_PORT = int(sys.argv[1])
WHITELIST_FILE = sys.argv[2]
UPSTREAM_DNS = "8.8.8.8"

def load_whitelist():
    domains = set()
    try:
        with open(WHITELIST_FILE) as f:
            for line in f:
                line = line.strip().lower().rstrip('.')
                if line and not line.startswith('#'):
                    domains.add(line)
    except FileNotFoundError:
        pass
    return domains

def is_allowed(hostname):
    hostname = hostname.lower().rstrip('.')
    if not hostname:
        return False
    domains = load_whitelist()
    if hostname in domains:
        return True
    parts = hostname.split('.')
    for i in range(1, len(parts)):
        if '.'.join(parts[i:]) in domains:
            return True
    return False

def parse_sni(data):
    try:
        if len(data) < 5 or data[0] != 0x16:
            return None
        idx = 5
        if idx + 4 > len(data): return None
        idx += 4
        if idx + 2 > len(data): return None
        idx += 2
        if idx + 32 > len(data): return None
        idx += 32
        if idx >= len(data): return None
        sid_len = data[idx]
        idx += 1 + sid_len
        if idx + 2 > len(data): return None
        cs_len = struct.unpack('>H', data[idx:idx+2])[0]
        idx += 2 + cs_len
        if idx >= len(data): return None
        comp_len = data[idx]
        idx += 1 + comp_len
        if idx + 2 > len(data): return None
        ext_total = struct.unpack('>H', data[idx:idx+2])[0]
        idx += 2
        ext_end = idx + ext_total
        while idx + 4 <= ext_end:
            ext_type = struct.unpack('>H', data[idx:idx+2])[0]
            ext_len = struct.unpack('>H', data[idx+2:idx+4])[0]
            idx += 4
            if ext_type == 0x0000 and ext_len >= 5:
                entry_idx = idx + 2
                if entry_idx + 3 > idx + ext_len:
                    return None
                if data[entry_idx] != 0:
                    return None
                name_len = struct.unpack('>H', data[entry_idx+1:entry_idx+3])[0]
                return data[entry_idx+3:entry_idx+3+name_len].decode('ascii', errors='ignore')
            idx += ext_len
        return None
    except Exception:
        return None

def parse_host(data):
    try:
        text = data.decode('utf-8', errors='ignore')
        for line in text.split('\r\n'):
            s = line.strip()
            if s.lower().startswith('host:'):
                val = s[5:].strip()
                if ':' in val:
                    val = val.rsplit(':', 1)[0]
                return val
        return None
    except Exception:
        return None

def udp_resolve(query):
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.settimeout(5)
    try:
        s.sendto(query, (UPSTREAM_DNS, 53))
        resp, _ = s.recvfrom(4096)
        return resp
    finally:
        s.close()

def pump(src, dst):
    try:
        while True:
            data = src.recv(65536)
            if not data:
                break
            dst.sendall(data)
    except (ConnectionResetError, BrokenPipeError, OSError):
        pass
    finally:
        try:
            dst.shutdown(socket.SHUT_WR)
        except OSError:
            pass

def qname(data):
    """Return (name, offset_after_qname) for the first question in a DNS packet."""
    labels = []
    i = 12
    while i < len(data):
        length = data[i]
        if length == 0:
            i += 1
            break
        if length & 0xC0:            # compression pointer: not expected in queries
            return None, None
        labels.append(data[i + 1:i + 1 + length].decode('ascii', errors='ignore'))
        i += 1 + length
    if not labels:
        return None, None
    return '.'.join(labels).lower(), i

def nxdomain_response(query):
    """Echo the question back with rcode 3 (NXDOMAIN) and no answers."""
    header = query[:2] + b'\x81\x83' + query[4:6] + b'\x00\x00\x00\x00\x00\x00'
    return header + query[12:]

def nodata_response(query):
    """Rcode 0 with no answers: the name exists but has no record of that type."""
    header = query[:2] + b'\x81\x80' + query[4:6] + b'\x00\x00\x00\x00\x00\x00'
    return header + query[12:]

def handle_dns(conn, data):
    """DNS: data = b'DNS' + 2-byte-len + query (may need more reads)."""
    try:
        payload = data[3:]
        if len(payload) < 2:
            return
        msg_len = struct.unpack('>H', payload[:2])[0]
        query = payload[2:2+msg_len]
        while len(query) < msg_len:
            chunk = conn.recv(msg_len - len(query))
            if not chunk:
                break
            query += chunk

        name, qoff = qname(query) if len(query) >= 12 else (None, None)
        if name and not is_allowed(name):
            # Fail fast instead of letting the client dial a connection the
            # HTTP/HTTPS proxy will drop anyway.
            conn.sendall(struct.pack('>H', len(nxdomain_response(query))) + nxdomain_response(query))
            return

        # Only IPv4 gets DNAT'ed to this proxy inside the VM, so an IPv6 address
        # would be a dead end: answer AAAA with NODATA and let the client use A.
        if name and qoff is not None and len(query) >= qoff + 2:
            if struct.unpack('>H', query[qoff:qoff + 2])[0] == 28:  # AAAA
                nod = nodata_response(query)
                conn.sendall(struct.pack('>H', len(nod)) + nod)
                return

        resp = udp_resolve(query)
        conn.sendall(struct.pack('>H', len(resp)) + resp)
    except Exception:
        pass
    finally:
        conn.close()

def handle_http_https(conn, data):
    """HTTP/HTTPS: DNAT'd raw connection from VM."""
    try:
        # Read only until the first complete request unit is buffered. Reading a
        # fixed number of bytes would block on the client's reply and drop the
        # connection (short curl/npm requests are under 512 bytes).
        while True:
            if data[0] == 0x16:
                if len(data) >= 5:
                    rl = struct.unpack('>H', data[3:5])[0]
                    if len(data) >= 5 + rl:
                        break
            else:
                if b'\r\n\r\n' in data:
                    break
            if len(data) >= 16384:
                break
            chunk = conn.recv(4096)
            if not chunk:
                return
            data += chunk

        if data[0] == 0x16:
            hostname = parse_sni(data)
            port = 443
        else:
            hostname = parse_host(data)
            port = 80

        if not hostname:
            conn.close()
            return

        if not is_allowed(hostname):
            conn.close()
            return

        upstream = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        upstream.settimeout(15)
        upstream.connect((hostname, port))
        upstream.settimeout(None)

        # Forward original bytes to real server
        upstream.sendall(data)

        t = threading.Thread(target=pump, args=(conn, upstream), daemon=True)
        t.start()
        pump(upstream, conn)
        t.join()
        conn.close()
        upstream.close()
    except Exception:
        try:
            conn.close()
        except OSError:
            pass

def handle_client(conn, addr):
    try:
        conn.settimeout(15)
        data = conn.recv(4096)
        if not data:
            conn.close()
            return
        if data.startswith(b"DNS"):
            handle_dns(conn, data)
        else:
            handle_http_https(conn, data)
    except Exception:
        try:
            conn.close()
        except OSError:
            pass

def main():
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    sock.bind((BIND_ADDR, BIND_PORT))
    sock.listen(128)
    n = len(load_whitelist())
    print(f"Host proxy on {BIND_ADDR}:{BIND_PORT} | {n} domains | HTTP/HTTPS+DNS", flush=True)
    while True:
        conn, addr = sock.accept()
        threading.Thread(target=handle_client, args=(conn, addr), daemon=True).start()

if __name__ == '__main__':
    main()
PYEOF

  nohup python3 "$HOST_PROXY_SCRIPT" "$HOST_PROXY_PORT" "$WHITELIST_FILE" > "$HOST_PROXY_LOG" 2>&1 &
  local pid=$!
  echo $pid > "$HOST_PROXY_PIDFILE"

  sleep 0.5
  if ! kill -0 $pid 2>/dev/null; then
    echo "ERROR: Host proxy failed to start. See $HOST_PROXY_LOG" >&2
    cat "$HOST_PROXY_LOG" >&2
    exit 1
  fi
  echo "  Host proxy ready on 127.0.0.1:$HOST_PROXY_PORT"
}

#--------------------------------------------------------------------------------
# VM FIREWALL (nftables REDIRECT + transparent proxy, runs inside VM via SSH)
#--------------------------------------------------------------------------------

# Guest-side network policy. Everything that touches the guest kernel is done by
# one generated shell script instead of a long '&& ... || true' chain over SSH:
# such chains skip every later step after the first failure, which used to leave
# the VM with a pinned /etc/resolv.conf and no nftables rules at all.
guest_firewall_script() {
  cat > "$INSTANCE_HOME/agent-sandbox-firewall.sh" <<GUESTFW
#!/bin/sh
# Installed by agent-sandbox. apply | remove | status
set -eu

NFT_FILE=/etc/sandbox/firewall.nft
DNS_UNIT=dns-proxy
FW_UNIT=sandbox-firewall

flush() {
  nft delete table ip sandbox_proxy >/dev/null 2>&1 || true
  nft delete table ip sandbox_filter >/dev/null 2>&1 || true
}

apply() {
  # QEMU's user-net lease hands out an address but no IPv4 router, and without a
  # default route the kernel's routing check fails before the DNAT below can
  # rewrite the destination, so every whitelisted connection would die. slirp
  # runs with restrict=on, so this route cannot reach the internet by itself.
  IFACE=$(ip -o -4 route show to exact 10.0.2.0/24 | awk '{print $5; exit}')
  [ -n "\$IFACE" ] || IFACE=ens3
  ip route replace default via 10.0.2.2 dev "\$IFACE" || {
    echo "agent-sandbox-firewall: cannot set a default route via 10.0.2.2 on \$IFACE" >&2
    exit 1
  }

  # Fail closed: a partially loaded ruleset is no policy at all.
  flush
  nft -f "\$NFT_FILE"
  nft list table ip sandbox_filter >/dev/null
  nft list table ip sandbox_proxy >/dev/null

  systemctl enable "\$DNS_UNIT" "\$FW_UNIT"

  # Take DNS away from systemd-resolved so nothing can reopen a path around the
  # whitelist proxy by rewriting the resolver config.
  systemctl stop systemd-resolved >/dev/null 2>&1 || true
  systemctl mask systemd-resolved >/dev/null 2>&1 || true
  chattr -i /etc/resolv.conf >/dev/null 2>&1 || true
  rm -f /etc/resolv.conf
  printf 'nameserver 127.0.0.1\\n' > /etc/resolv.conf
  chmod 0644 /etc/resolv.conf
  chattr +i /etc/resolv.conf >/dev/null 2>&1 || true
  lsattr /etc/resolv.conf
}

remove() {
  IFACE=$(ip -o -4 route show to exact 10.0.2.0/24 | awk '{print $5; exit}')
  [ -n "\$IFACE" ] || IFACE=ens3
  ip route replace default via 10.0.2.2 dev "\$IFACE" 2>/dev/null || true
  systemctl disable --now "\$DNS_UNIT" "\$FW_UNIT" >/dev/null 2>&1 || true
  flush
  systemctl unmask systemd-resolved >/dev/null 2>&1 || true
  systemctl daemon-reload
  systemctl restart systemd-resolved >/dev/null 2>&1 || true
  chattr -i /etc/resolv.conf >/dev/null 2>&1 || true
  rm -f /etc/resolv.conf

  # Hand the VM back a resolver config instead of leaving /etc/resolv.conf
  # missing. QEMU's user-mode stack only answers name queries when its own host
  # side resolver is reachable from slirp, which a systemd-resolved stub on the
  # host is not, so without a whitelist this file is a placeholder: outbound DNS
  # is only guaranteed through the whitelist proxy.
  DNS=\$(sed -n 's/^DNS=\([^ ]*\).*/\1/p' /run/systemd/netif/leases/* 2>/dev/null | head -1)
  [ -n "\$DNS" ] || DNS=10.0.2.3
  printf 'nameserver %s\\n' "\$DNS" > /etc/resolv.conf
  chmod 0644 /etc/resolv.conf
  lsattr /etc/resolv.conf 2>/dev/null || true
}

status() {
  nft list ruleset
  lsattr /etc/resolv.conf 2>/dev/null || true
  systemctl is-active "\$DNS_UNIT" "\$FW_UNIT"
}

case "\${1:-apply}" in
  apply)  apply ;;
  remove) remove ;;
  status) status ;;
  *) echo "usage: \$0 apply|remove|status" >&2; exit 2 ;;
esac
GUESTFW
}

# Copy a generated file into the VM and give it the mode it needs, because scp
# does not preserve the local one.
copy_to_vm() {
  local src="$1" dest="$2" mode="$3"
  if ! scp -i "$SSH_KEY" -P "$SSH_PORT" -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null "$src" "root@127.0.0.1:$dest"; then
    echo "ERROR: could not copy $(basename "$src") into the VM." >&2
    exit 1
  fi
  if ! _ssh root "chmod $mode '$dest'" >/dev/null; then
    echo "ERROR: could not set permissions on $dest in the VM." >&2
    exit 1
  fi
}

setup_vm_firewall() {
  echo "  Setting up in-VM firewall (nftables DNAT + DNS forwarder + input policy)..."

  # --- In-VM DNS forwarder: UDP :53 -> TCP to the host proxy ("DNS" magic) ---
  # No forking: systemd supervises it, so a crash is visible in the journal.
  cat > "$INSTANCE_HOME/dns_proxy.py" <<'DNSPROXY'
#!/usr/bin/env python3
"""In-VM DNS helper: UDP :53 -> TCP to the host whitelist proxy."""
import socket, struct, sys, threading

# Args: <host-proxy port> [host-proxy address] [listen port]
PORT = int(sys.argv[1]) if len(sys.argv) > 1 else 14000
HOST = sys.argv[2] if len(sys.argv) > 2 else "10.0.2.100"
LISTEN_PORT = int(sys.argv[3]) if len(sys.argv) > 3 else 53

def fwd(q):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(5)
        s.connect((HOST, PORT))
        s.sendall(b"DNS" + struct.pack(">H", len(q)) + q)
        hdr = b""
        while len(hdr) < 2:
            chunk = s.recv(2 - len(hdr))
            if not chunk:
                return b""
            hdr += chunk
        n = struct.unpack(">H", hdr)[0]
        r = b""
        while len(r) < n:
            chunk = s.recv(n - len(r))
            if not chunk:
                return b""
            r += chunk
        return r

def handle(sock, data, addr):
    try:
        answer = fwd(data)
        if answer:
            sock.sendto(answer, addr)
    except Exception:
        pass

s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
s.bind(("0.0.0.0", LISTEN_PORT))
while True:
    data, addr = s.recvfrom(4096)
    threading.Thread(target=handle, args=(s, data, addr), daemon=True).start()
DNSPROXY

  # --- systemd unit for the forwarder ---
  cat > "$INSTANCE_HOME/dns-proxy.service" <<UNIT
[Unit]
Description=agent-sandbox DNS forwarder (127.0.0.1:53 -> host proxy)

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/dns_proxy.py $HOST_PROXY_PORT
Restart=always
RestartSec=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
UNIT

  # --- re-apply the policy after a VM reboot so it never silently disappears ---
  # Must run *after* the interface has its address: the policy needs the default
  # route to exist before the DNAT can be used, so an early (network-pre) start
  # makes the unit fail and leaves the VM without any policy.
  cat > "$INSTANCE_HOME/sandbox-firewall.service" <<UNIT
[Unit]
Description=agent-sandbox network policy
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/agent-sandbox-firewall.sh apply

[Install]
WantedBy=multi-user.target
UNIT

  # --- nftables: DNAT to the host proxy + default-deny input policy ---
  # Written locally to avoid brace-quoting problems over SSH.
  cat > "$INSTANCE_HOME/firewall.nft" <<NFT
table ip sandbox_proxy {
  chain out {
    type nat hook output priority -1; policy accept;
    ip daddr 10.0.2.0/24 return
    ip daddr 127.0.0.1 return
    tcp dport 80 dnat to 10.0.2.100:$HOST_PROXY_PORT
    tcp dport 443 dnat to 10.0.2.100:$HOST_PROXY_PORT
  }
}

# Default-deny for anything arriving at the VM. Outbound connections (LLM proxy,
# registry, host proxy, Docker pulls through the local registry) are covered by
# "ct state established" replies, and container traffic leaving through
# FORWARD is untouched.
table ip sandbox_filter {
  chain input {
    type filter hook input priority 0; policy drop;

    iif lo accept
    ct state established,related accept
    ct state invalid drop

    # DHCP renew on the slirp interface (nft needs 'udp' twice here).
    udp sport 67 udp dport 68 accept

    # Docker bridge DNS helper only.
    ip saddr 172.16.0.0/12 udp dport 53 accept
    ip saddr 172.16.0.0/12 tcp dport 53 accept

    # QEMU user-mode forwarding arrives from the slirp gateway (10.0.2.2):
    # SSH, plus the OpenCode port that HAProxy on the host connects to.
    ip saddr 10.0.2.2 tcp dport 22 accept
    ip saddr 10.0.2.2 tcp dport $OPENCODE_VM_PORT accept
  }
}
NFT

  guest_firewall_script

  # --- Copy the generated files into the VM ---
  _ssh root "install -d -m 0755 /etc/sandbox" >/dev/null
  copy_to_vm "$INSTANCE_HOME/dns_proxy.py" /usr/local/bin/dns_proxy.py 0755
  copy_to_vm "$INSTANCE_HOME/dns-proxy.service" /etc/systemd/system/dns-proxy.service 0644
  copy_to_vm "$INSTANCE_HOME/sandbox-firewall.service" /etc/systemd/system/sandbox-firewall.service 0644
  copy_to_vm "$INSTANCE_HOME/firewall.nft" /etc/sandbox/firewall.nft 0644
  copy_to_vm "$INSTANCE_HOME/agent-sandbox-firewall.sh" /usr/local/bin/agent-sandbox-firewall.sh 0755

  # --- Apply inside the guest through systemd ---
  # Letting the unit run the script (instead of calling it over SSH) means the
  # unit state matches reality and the exact same code path runs on a VM reboot.
  if ! _ssh root "systemctl daemon-reload && systemctl restart sandbox-firewall && systemctl restart dns-proxy && systemctl is-active dns-proxy sandbox-firewall"; then
    echo "ERROR: could not apply the in-VM network policy." >&2
    echo "       Refusing to start the agent with no firewall in place." >&2
    echo "       Ruleset that failed: $INSTANCE_HOME/firewall.nft" >&2
    exit 1
  fi

  echo "  VM firewall active: DNAT -> host proxy | input policy drop | DNS pinned to 127.0.0.1"
}

# Undo the in-VM lockdown when the instance runs without a whitelist, so a
# previously locked-down session cannot stay half-enforced.
teardown_vm_firewall() {
  # Only worth a round trip if a previous run actually locked this VM down.
  if ! ssh -q -i "$SSH_KEY" -p "$SSH_PORT" -o BatchMode=yes \
        -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
        "root@127.0.0.1" "test -x /usr/local/bin/agent-sandbox-firewall.sh" >/dev/null 2>&1; then
    return
  fi

  echo "  Clearing in-VM firewall (restrict-network off or no whitelist)..."

  # The copy inside the VM may have been installed by an older release of this
  # script, and undoing the lockdown with a stale version can leave the guest
  # half-configured (an old remove() deleted /etc/resolv.conf without putting a
  # resolver back). Refresh the script, then let it undo its own work.
  guest_firewall_script
  if scp -i "$SSH_KEY" -P "$SSH_PORT" -o StrictHostKeyChecking=no \
       -o UserKnownHostsFile=/dev/null "$INSTANCE_HOME/agent-sandbox-firewall.sh" \
       "root@127.0.0.1:/usr/local/bin/agent-sandbox-firewall.sh" >/dev/null 2>&1; then
    _ssh root "chmod 0755 /usr/local/bin/agent-sandbox-firewall.sh" >/dev/null || true
  else
    echo "  WARNING: could not refresh the policy script in the VM," >&2
    echo "           using the version already installed there." >&2
  fi

  _ssh root "/usr/local/bin/agent-sandbox-firewall.sh remove" || \
    echo "  WARNING: in-VM policy removal reported an error" >&2
}

