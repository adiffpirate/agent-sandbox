#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE_EOF'
Usage:
  agent-sandbox run [--agent <agent>] [--model <model>] [--context-size <size>] [--vm-memory <size>] [--vm-threads <count>] [--local-llm-host <ip>] [--local-llm-port <port>] [--restrict-network on|off] [--dns-whitelist <domains>] [--workdir-ro] (requires prior 'build')
  agent-sandbox ssh <user> <command>
  agent-sandbox build <extra_command>
  agent-sandbox sync docker [filter_regex]
  agent-sandbox sync file <host_path>[:<vm_path>]
  agent-sandbox status
  agent-sandbox stop
  agent-sandbox clean
  agent-sandbox purge

Run options:
  --agent <agent>            Agent to run (opencode, claude, qwen, ssh). Default: opencode (web mode)
  --model <model>            Model to use. Default: code
  --context-size <size>      Maximum context window for opencode (half for output limit). Default: 124000
  --vm-memory <size>         VM RAM (e.g. 4G, 8G). Default: 4G
  --vm-threads <count>       VM CPU threads. Default: 80% of host threads
  --local-llm-host <ip>      Host IP for LLM proxy. Default: 192.168.0.210
  --local-llm-port <port>    Host port for LLM proxy. Default: 8080
  --restrict-network on|off  Restrict VM network. Default: on
  --dns-whitelist <domains>  Comma-separated list of allowed domains.
                             When provided with --restrict-network on, enables fine-grained
                             domain whitelist via in-VM transparent proxy + host CONNECT proxy.
                             Without it, --restrict-network on simply blocks all external traffic.
                             Subdomain matching is automatic: "github.com" allows "api.github.com".
                             Example: --dns-whitelist github.com,npmjs.org,pypi.org
  --workdir-ro               Mount workdir as read-only in the VM

  NOTE: Running 'run' on an already-active instance will stop and restart it
        with the new flags (useful for toggling --workdir-ro, --dns-whitelist, etc).

Build options:
  --vm-memory <size>         VM RAM (e.g. 4G, 8G). Default: 4G
  --vm-threads <count>       VM CPU threads. Default: 80% of host threads
  --local-llm-host <ip>      Host IP for LLM proxy. Default: 192.168.0.210
  --local-llm-port <port>    Host port for LLM proxy. Default: 8080
USAGE_EOF
  exit 1
}

#--------------------------------------------------------------------------------
# GLOBAL VARIABLES (shared across all instances)
#--------------------------------------------------------------------------------

SANDBOX_HOME="$HOME/.local/share/agent-sandbox"
BASE_IMAGE="$SANDBOX_HOME/vm-base-image.qcow2"
GOLDEN_IMAGE="$SANDBOX_HOME/vm-golden-image.qcow2"
SEED_ISO="$SANDBOX_HOME/seed.iso"
USER_DATA="$SANDBOX_HOME/user-data"
META_DATA="$SANDBOX_HOME/meta-data"
SSH_KEY="$SANDBOX_HOME/agent-sandbox_ed25519"
SSH_PUB="$SSH_KEY.pub"
OVMF_CODE_COPY="$SANDBOX_HOME/OVMF_CODE.fd"
DOWNLOAD_IMAGE="https://dl-cdn.alpinelinux.org/alpine/v3.23/releases/cloud/generic_alpine-3.23.4-x86_64-uefi-cloudinit-r0.qcow2"
OVMF_CODE_SOURCE="/usr/share/ovmf/OVMF.fd"
OVMF_VARS_SOURCE="/usr/share/ovmf/OVMF.fd"

WORKDIR="$(pwd)"

#--------------------------------------------------------------------------------
# PER-INSTANCE VARIABLES
#--------------------------------------------------------------------------------

INSTANCE_ID="inst-$(echo -n "$WORKDIR" | sha256sum | head -c 8)"
INSTANCE_HOME="$SANDBOX_HOME/instances/$INSTANCE_ID"

INSTANCE_PORT_OFFSET=$(( 16#$(echo -n "$INSTANCE_ID" | md5sum | head -c 4) % 1000 ))

SSH_PORT=$((2222 + INSTANCE_PORT_OFFSET))

HAPROXY_LISTEN_PORT=$((11434 + INSTANCE_PORT_OFFSET))
LOCAL_LLM_HOST="192.168.0.210"
LOCAL_LLM_SERVER_PORT="8080"

REGISTRY_LISTEN_PORT=$((5000 + INSTANCE_PORT_OFFSET))
REGISTRY_ENDPOINT="10.0.2.100:5000"

SESSION_IMAGE="$INSTANCE_HOME/vm-session-disk.qcow2"
OVMF_VARS_COPY="$INSTANCE_HOME/OVMF_VARS.fd"
FS_SOCK="$INSTANCE_HOME/virtiofsd.sock"
QEMU_PIDFILE="$INSTANCE_HOME/qemu.pid"
QEMU_LOG="$INSTANCE_HOME/qemu.log"
VIRTIOFSD_PIDFILE="$INSTANCE_HOME/virtiofsd.sock.pid"
VIRTIOFSD_LOG="$INSTANCE_HOME/virtiofsd.log"
HAPROXY_CONFIG="$INSTANCE_HOME/haproxy.conf"
HAPROXY_PIDFILE="$INSTANCE_HOME/haproxy.pid"
HAPROXY_LOG="$INSTANCE_HOME/haproxy.log"
REGISTRY_CONFIG="$INSTANCE_HOME/registry.conf"
REGISTRY_PIDFILE="$INSTANCE_HOME/registry.pid"
REGISTRY_LOG="$INSTANCE_HOME/registry.log"
REGISTRY_DIR="$INSTANCE_HOME/registry"
AGENT_ALIVE="$INSTANCE_HOME/agent.alive"

# Host-side proxy (handles HTTP/HTTPS + DNS, per-instance)
HOST_PROXY_PORT=$((14000 + INSTANCE_PORT_OFFSET))
HOST_PROXY_SCRIPT="$INSTANCE_HOME/host_proxy.py"
HOST_PROXY_PIDFILE="$INSTANCE_HOME/host_proxy.pid"
HOST_PROXY_LOG="$INSTANCE_HOME/host_proxy.log"
# Whitelist
WHITELIST_FILE="$INSTANCE_HOME/dns-whitelist.txt"

OPENCODE_WEB_PORT=$((9090 + INSTANCE_PORT_OFFSET))

# VM internals
VM_NAME="agent-sandbox-$INSTANCE_ID"
VM_DISK_SIZE="20G"
VM_MEMORY_RAM="4G"
VM_THREADS=$(( $(nproc 2>/dev/null || echo 4) * 80 / 100 ))
[[ "$VM_THREADS" -lt 1 ]] && VM_THREADS=4
VM_RESTRICT_NETWORK="on"
VM_WORKDIR_RO="off"
VM_AGENT_USER="agent"
VM_AGENT_WORKDIR="/home/$VM_AGENT_USER/workdir"

CMD_DEFAULT_RUN_AGENT="opencode"
CMD_DEFAULT_RUN_LOCAL_MODEL="code"

#--------------------------------------------------------------------------------
# MAIN
#--------------------------------------------------------------------------------

main() {
  if [[ $# -eq 0 ]]; then
    usage
  fi

  local subcommand="$1"
  shift || true

  case "$subcommand" in
    build)
      local cmd="${*:-echo}"
      _build "$cmd"
      ;;
    run)
      local agent="$CMD_DEFAULT_RUN_AGENT"
      local model="$CMD_DEFAULT_RUN_LOCAL_MODEL"
      local vm_memory="$VM_MEMORY_RAM"
      local vm_threads="$VM_THREADS"
      local local_llm_host="$LOCAL_LLM_HOST"
      local local_llm_server_port="$LOCAL_LLM_SERVER_PORT"
      local context_size=124000
      local restrict_network="$VM_RESTRICT_NETWORK"
      local workdir_ro="$VM_WORKDIR_RO"
      local dns_whitelist=""

      while [[ $# -gt 0 ]]; do
        case "$1" in
          --agent) agent="$2"; shift 2 ;;
          --model) model="$2"; shift 2 ;;
          --context-size) context_size="$2"; shift 2 ;;
          --vm-memory) vm_memory="$2"; shift 2 ;;
          --vm-threads) vm_threads="$2"; shift 2 ;;
          --local-llm-host) local_llm_host="$2"; shift 2 ;;
          --local-llm-port) local_llm_server_port="$2"; shift 2 ;;
          --restrict-network) restrict_network="$2"; shift 2 ;;
          --workdir-ro) workdir_ro="on"; shift ;;
          --dns-whitelist) dns_whitelist="$2"; shift 2 ;;
          *) usage ;;
        esac
      done

      VM_MEMORY_RAM="$vm_memory"
      VM_THREADS="$vm_threads"
      LOCAL_LLM_HOST="$local_llm_host"
      LOCAL_LLM_SERVER_PORT="$local_llm_server_port"
      VM_RESTRICT_NETWORK="$restrict_network"
      VM_WORKDIR_RO="$workdir_ro"
      _run "$agent" "$model" "$context_size" "$dns_whitelist"
      ;;
    ssh)
      local user="${1:-$VM_AGENT_USER}"
      shift || true
      local cmd="${*:-bash}"
      _ssh "$user" "$cmd"
      ;;
    status)
      _status
      ;;
    sync)
      local sync_mode="${1:-docker}"
      shift || true
      local sync_arg="${1:-}"
      _sync "$sync_mode" "$sync_arg"
      ;;
    stop)
      _stop
      ;;
    clean)
      _clean
      ;;
    purge)
      _purge
      ;;
    *)
      usage
      ;;
  esac
}

#--------------------------------------------------------------------------------
# UTILS
#--------------------------------------------------------------------------------

have_cmd() {
  command -v "$1" >/dev/null 2>&1
}

virtiofsd_bin() {
  if have_cmd virtiofsd; then
    command -v virtiofsd
  elif [[ -x /usr/libexec/virtiofsd ]]; then
    echo /usr/libexec/virtiofsd
  elif [[ -x /usr/lib/qemu/virtiofsd ]]; then
    echo /usr/lib/qemu/virtiofsd
  else
    return 1
  fi
}

is_running(){
  local daemon=$1
  _status | grep "$INSTANCE_ID" | grep -q "$daemon"
}

#--------------------------------------------------------------------------------
# PRE REQUISITES
#--------------------------------------------------------------------------------

ensure_prereqs() {
  ensure_packages
  ensure_global_dirs
  ensure_instance_dirs
  ensure_ssh_key
  ensure_uefi
}

ensure_packages() {
  local missing=0

  for c in "curl" "pwgen" "ssh" "ssh-keygen" "genisoimage" "qemu-system-x86_64" "qemu-img" "newuidmap" "nc" "haproxy" "registry" "socat" "rsync" "python3"; do
    if ! have_cmd "$c"; then
      echo "Missing command: $c" >&2
      missing=1
    fi
  done

  if ! virtiofsd_bin >/dev/null 2>&1; then
    echo "Missing command: virtiofsd" >&2
    missing=1
  fi

  if [[ ! -f "$OVMF_CODE_SOURCE" ]]; then
    echo "Missing UEFI firmware: ovmf" >&2
    missing=1
  fi

  if [[ ! -e /dev/kvm ]]; then
    echo "Missing /dev/kvm (KVM not available)" >&2
    missing=1
  else
    if [[ ! -r /dev/kvm || ! -w /dev/kvm ]]; then
      echo "No permission to use /dev/kvm (are you in the kvm group?)" >&2
      missing=1
    fi
  fi

  if [[ "$missing" -ne 0 ]]; then
    cat >&2 <<'EOF'
Install prerequisites:
  sudo apt install -y curl pwgen openssh-client genisoimage qemu-system-x86 qemu-utils virtiofsd uidmap ovmf moreutils haproxy socat rsync python3
  curl -L https://github.com/distribution/distribution/releases/download/v3.1.0/registry_3.1.0_linux_amd64.tar.gz -o /tmp/registry.tar.gz
  tar -xzf /tmp/registry.tar.gz -C "/tmp" && sudo mv /tmp/registry /usr/local/bin/registry && sudo chmod +x /usr/local/bin/registry

Ensure KVM is enabled:
  - BIOS/UEFI virtualization (Intel VT-x / AMD-V)
  - Kernel module loaded (kvm, kvm_intel or kvm_amd)
  - User in kvm group: sudo usermod -aG kvm $USER
  - On WSL2: https://serverfault.com/a/1115773
EOF
    exit 1
  fi
}

ensure_global_dirs() {
  mkdir -p "$SANDBOX_HOME"
}

ensure_instance_dirs() {
  mkdir -p "$INSTANCE_HOME"
  echo -n "$WORKDIR" > "$INSTANCE_HOME/.instance_path"
}

ensure_uefi() {
  if [[ ! -f "$OVMF_CODE_COPY" ]]; then
    cp "$OVMF_CODE_SOURCE" "$OVMF_CODE_COPY"
  fi
  if [[ ! -f "$OVMF_VARS_COPY" ]]; then
    cp "$OVMF_VARS_SOURCE" "$OVMF_VARS_COPY"
  fi
}

ensure_ssh_key() {
  if [[ ! -f "$SSH_KEY" ]]; then
    ssh-keygen -t ed25519 -N "" -f "$SSH_KEY" >/dev/null
  fi
}

#--------------------------------------------------------------------------------
# BUILD (global operation)
#--------------------------------------------------------------------------------

download_base_image() {
  if [[ ! -f "$BASE_IMAGE" ]]; then
    echo "Downloading base image from $DOWNLOAD_IMAGE"
    curl -L --fail --progress-bar "$DOWNLOAD_IMAGE" -o "$BASE_IMAGE"
    chmod -w "$BASE_IMAGE"
  fi
}

create_cloud_init() {
  local extra_cmd="$1"

  local custom_ca_config=""
  if ls /usr/local/share/ca-certificates/*.crt >/dev/null 2>&1; then
    custom_ca_config="bootcmd:\n  - [ cloud-init-per, instance, setup-ca, sh, -c, \"SSL_NO_VERIFY=1 apk add --no-cache --no-check-certificate ca-certificates\" ]\n\n"
    custom_ca_config+="ca_certs:\n  trusted:"
    for cert in /usr/local/share/ca-certificates/*.crt; do
      custom_ca_config+="\n    - |\n$(sed 's/^/      /' "$cert")"
    done
  fi

  cat >"$USER_DATA" <<EOF
#cloud-config

$(echo -e "$custom_ca_config")

package_update: true
packages:
  - bash
  - vim
  - git
  - curl
  - ripgrep
  - build-base
  - python3-dev
  - py3-pip
  - npm
  - docker
  - docker-cli
  - docker-cli-compose
  - containerd
  - nftables

runcmd:
  - set -xeo pipefail
  # Install agent: opencode
  - npm install -g opencode-linux-x64-musl
  - ln -s /usr/local/lib/node_modules/opencode-linux-x64-musl/bin/opencode /usr/local/bin/opencode
  # Dummy xdg-open for headless VM (opencode web tries to open browser)
  - printf '#!/bin/sh\nexit 0\n' > /usr/local/bin/xdg-open && chmod +x /usr/local/bin/xdg-open
  # Install agent: qwen
  - npm install -g @qwen-code/qwen-code@latest
  # Install agent: claude
  - wget -O /etc/apk/keys/claude-code.rsa.pub https://downloads.claude.ai/keys/claude-code.rsa.pub
  - echo "https://downloads.claude.ai/claude-code/apk/stable" >> /etc/apk/repositories
  - apk add claude-code
  # Enable docker service
  - rc-update add docker default
  # Install docker wrapper to force images be pulled from local registry
  - mv "\$(which docker)" /usr/bin/docker.real
  - curl -L https://github.com/adiffpirate/docker-wrapper-custom-registry/raw/refs/heads/main/docker.py -o /usr/local/bin/docker
  - chmod +x /usr/local/bin/docker
  # Disable GRUB timeout so VM boots instantly
  - sed -i 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=0/' /etc/default/grub
  - echo 'GRUB_TIMEOUT_STYLE=hidden' >> /etc/default/grub
  - grub-mkconfig -o /boot/grub/grub.cfg
  # Disable cloud-init for future boots
  - touch /etc/cloud/cloud-init.disabled
  # Run extra cmd
  - bash -c '$extra_cmd'

users:
  - name: root
    ssh_authorized_keys:
      - $(cat "$SSH_PUB")
  - name: $VM_AGENT_USER
    groups: [docker]
    shell: /bin/bash
    ssh_authorized_keys:
      - $(cat "$SSH_PUB")
  - name: alpine
    shell: /sbin/nologin

chpasswd:
  list: |
    root:$(pwgen --capitalize --numerals --symbols --secure 50 1)
    $VM_AGENT_USER:$VM_AGENT_USER

ssh_pwauth: false

write_files:
  - path: /etc/bash/bashrc
    append: true
    content: |
      if [ -f /etc/environment ]; then
        set -a
        . /etc/environment
        set +a
      fi
  - path: /etc/ssh/sshd_config.d/99-hardening.conf
    permissions: '0644'
    content: |
      PermitRootLogin prohibit-password
      PasswordAuthentication no
      ChallengeResponseAuthentication no
      UsePAM no
  - path: /etc/docker/daemon.json
    content: |
      {
        "insecure-registries": ["$REGISTRY_ENDPOINT"]
      }

power_state:
  mode: poweroff
  message: "========== CLOUD INIT SUCCESS === POWERING OFF =========="
  condition: sh -c '! cat /var/log/cloud-init*.log | grep -q -e "ERROR" -e "Error"'

final_message: |
  --------------------------------------------------------------------------------------------
  |                                 CLOUD INIT FINISHED                                      |
  --------------------------------------------------------------------------------------------
  |   IF YOU ARE SEEING THE LOGIN PROMPT IS BECAUSE SOMETHING WENT WRONG ON CLOUD-INIT       |
  |   INVESTIGATE THE LOGS: https://docs.cloud-init.io/en/latest/reference/user_files.html   |
  --------------------------------------------------------------------------------------------

  [TIP] SEE LOGS WITH:      cat /var/log/cloud-init*.log | grep -i error
  [TIP] SEE STATUS WITH:    cloud-init status -l
  [TIP] SSH IF AVAILABLE:   agent-sandbox ssh root
  [TIP] IF NOT LOGIN WITH:  user=$VM_AGENT_USER pass=$VM_AGENT_USER

  Good luck :)
EOF

  cat >"$META_DATA" <<EOF
instance-id: agent-sandbox
local-hostname: agent-sandbox
EOF

  genisoimage -output "$SEED_ISO" -volid cidata -rock "$USER_DATA" "$META_DATA"
}

build_golden_image() {
  qemu-img create -f qcow2 -b "$BASE_IMAGE" -F qcow2 "$GOLDEN_IMAGE" $VM_DISK_SIZE

  qemu-system-x86_64 \
    --enable-kvm \
    -cpu host -smp $VM_THREADS -m $VM_MEMORY_RAM \
    -drive if=pflash,format=raw,readonly=on,file="$OVMF_CODE_COPY" \
    -drive if=pflash,format=raw,file="$OVMF_VARS_COPY" \
    -drive file="$GOLDEN_IMAGE",if=virtio,format=qcow2 \
    -drive file="$SEED_ISO",format=raw \
    -device virtio-net-pci,netdev=net0 \
    -netdev user,id=net0,restrict=off,hostfwd=tcp:127.0.0.1:${SSH_PORT}-:22

  echo ""
  echo "Golden image built at $GOLDEN_IMAGE"
}

_build() {
  local extra_cmd="$1"
  _purge
  ensure_prereqs
  download_base_image
  create_cloud_init "$extra_cmd"
  build_golden_image
  clean_session_files
}

#--------------------------------------------------------------------------------
# RUN (per-instance)
#--------------------------------------------------------------------------------

create_session_overlay() {
  if [[ ! -f "$SESSION_IMAGE" ]]; then
    qemu-img create -f qcow2 -b "$GOLDEN_IMAGE" -F qcow2 "$SESSION_IMAGE" $VM_DISK_SIZE
    echo "VM Session Disk Image created at $SESSION_IMAGE"
  fi
}

start_virtiofsd() {
  if is_running virtiofsd; then
    echo "virtiofsd already running, skipping"
    return
  fi

  rm -f "$FS_SOCK"

  echo "Starting virtiofsd..."
  local ro_flag=""
  if [[ "$VM_WORKDIR_RO" == "on" ]]; then
    ro_flag="--readonly"
    echo "  (workdir mounted read-only)"
  fi

  nohup $(virtiofsd_bin) \
    --socket-path="$FS_SOCK" \
    --shared-dir="$WORKDIR" \
    --sandbox namespace \
    --uid-map=:1001:$(id -u):1: \
    --gid-map=:1002:$(id -g):1: \
    $ro_flag \
    >"$VIRTIOFSD_LOG" 2>&1 &

  local tries=50
  while [[ ! -S "$FS_SOCK" ]]; do
    sleep 0.1
    tries=$((tries - 1))
    if [[ "$tries" -le 0 ]]; then
      echo "ERROR: Timeout waiting for virtiofsd socket. See $VIRTIOFSD_LOG" >&2
      exit 1
    fi
  done
}

start_haproxy(){
  if is_running haproxy; then
    echo "haproxy already running, skipping"
    return
  fi

  if nc -z "127.0.0.1" $HAPROXY_LISTEN_PORT > /dev/null 2>&1; then
    echo "ERROR: Port $HAPROXY_LISTEN_PORT already in use" >&2
    exit 1
  fi

  echo "Starting haproxy on port $HAPROXY_LISTEN_PORT..."
  cat > "$HAPROXY_CONFIG" <<EOF
global
  log stdout format raw local0
  maxconn 256

defaults
  mode http
  log global
  log-format "[%tr] client=%ci:%cp server=%si:%sp method=%HM path=%HU http=%HV status=%ST req_size=%U resp_size=%B term=%tsc conn_retries=%rc srv_queue=%sq backend_queue=%bq actconn=%ac feconn=%fc beconn=%bc srvconn=%sc time_read_headers=%TR time_in_queue=%Tw time_tcp_connect=%Tc time_response=%Tr time_total=%Ta"
  option httpclose
  timeout connect 1s
  timeout client 1m
  timeout server 2m

frontend llm_in
  bind 0.0.0.0:$HAPROXY_LISTEN_PORT
  default_backend llm_out

backend llm_out
  server llm $LOCAL_LLM_HOST:$LOCAL_LLM_SERVER_PORT
  option accept-invalid-http-response
EOF

  nohup haproxy -f "$HAPROXY_CONFIG" -db -d > "$HAPROXY_LOG" 2>&1 &
  local pid=$!
  echo $pid > "$HAPROXY_PIDFILE"

  local tries=50
  until nc -z "127.0.0.1" $HAPROXY_LISTEN_PORT > /dev/null 2>&1; do
    sleep 1
    tries=$((tries - 1))
    if [[ "$tries" -le 0 ]]; then
      echo "ERROR: Timeout waiting for haproxy. See $HAPROXY_LOG" >&2
      exit 1
    fi
  done
}

start_registry(){
  if is_running registry; then
    echo "registry already running, skipping"
    return
  fi

  if nc -z "127.0.0.1" $REGISTRY_LISTEN_PORT > /dev/null 2>&1; then
    echo "ERROR: Port $REGISTRY_LISTEN_PORT already in use" >&2
    exit 1
  fi

  echo "Starting registry on port $REGISTRY_LISTEN_PORT..."
  mkdir -p "$REGISTRY_DIR"
  cat > "$REGISTRY_CONFIG" <<EOF
version: 0.1
log:
  level: debug
storage:
  filesystem:
    rootdirectory: $REGISTRY_DIR
http:
  addr: :$REGISTRY_LISTEN_PORT
EOF

  nohup registry serve "$REGISTRY_CONFIG" > "$REGISTRY_LOG" 2>&1 &
  local pid=$!
  echo $pid > "$REGISTRY_PIDFILE"

  local tries=50
  until nc -z "127.0.0.1" $REGISTRY_LISTEN_PORT > /dev/null 2>&1; do
    sleep 1
    tries=$((tries - 1))
    if [[ "$tries" -le 0 ]]; then
      echo "ERROR: Timeout waiting for registry. See $REGISTRY_LOG" >&2
      exit 1
    fi
  done
}

#--------------------------------------------------------------------------------
# WHITELIST + HOST CONNECT PROXY (per-instance, optional)
#--------------------------------------------------------------------------------

install_whitelist() {
  local csv="$1"

  local -a domains=()
  IFS=',' read -ra domains <<< "$csv"

  {
    for d in "${domains[@]}"; do
      local trimmed
      trimmed="$(echo "$d" | tr -d '[:space:]')"
      [[ -n "$trimmed" ]] && echo "$trimmed"
    done
  } > "$WHITELIST_FILE"

  local count
  count=$(wc -l < "$WHITELIST_FILE")
  echo "  Whitelist: $count domain(s)"
}

start_host_proxy() {
  if is_running host_proxy; then
    echo "Host proxy already running, skipping"
    return
  fi

  if nc -z "127.0.0.1" $HOST_PROXY_PORT > /dev/null 2>&1; then
    echo "ERROR: Port $HOST_PROXY_PORT already in use" >&2
    exit 1
  fi

  echo "Starting host proxy on 127.0.0.1:$HOST_PROXY_PORT (HTTP/HTTPS + DNS)..."

  cat > "$HOST_PROXY_SCRIPT" <<'PYEOF'
#!/usr/bin/env python3
"""Host-side whitelist proxy.
Handles:
  - HTTP/HTTPS: DNAT'd connections from VM. Reads SNI or Host header,
    checks whitelist, tunnels to real server.
  - DNS: connections prefixed with b"DNS" + length + query.
    Forwards to upstream DNS, returns response.
"""
import socket, struct, threading, sys

BIND_ADDR = "127.0.0.1"
BIND_PORT = int(sys.argv[1])
WHITELIST_FILE = sys.argv[2]
UPSTREAM_DNS = "8.8.8.8"

def load_whitelist():
    domains = set()
    try:
        with open(WHITELIST_FILE) as f:
            for line in f:
                line = line.strip().lower().rstrip('.')
                if line and not line.startswith('#'):
                    domains.add(line)
    except FileNotFoundError:
        pass
    return domains

def is_allowed(hostname):
    hostname = hostname.lower().rstrip('.')
    if not hostname:
        return False
    domains = load_whitelist()
    if hostname in domains:
        return True
    parts = hostname.split('.')
    for i in range(1, len(parts)):
        if '.'.join(parts[i:]) in domains:
            return True
    return False

def parse_sni(data):
    try:
        if len(data) < 5 or data[0] != 0x16:
            return None
        idx = 5
        if idx + 4 > len(data): return None
        idx += 4
        if idx + 2 > len(data): return None
        idx += 2
        if idx + 32 > len(data): return None
        idx += 32
        if idx >= len(data): return None
        sid_len = data[idx]
        idx += 1 + sid_len
        if idx + 2 > len(data): return None
        cs_len = struct.unpack('>H', data[idx:idx+2])[0]
        idx += 2 + cs_len
        if idx >= len(data): return None
        comp_len = data[idx]
        idx += 1 + comp_len
        if idx + 2 > len(data): return None
        ext_total = struct.unpack('>H', data[idx:idx+2])[0]
        idx += 2
        ext_end = idx + ext_total
        while idx + 4 <= ext_end:
            ext_type = struct.unpack('>H', data[idx:idx+2])[0]
            ext_len = struct.unpack('>H', data[idx+2:idx+4])[0]
            idx += 4
            if ext_type == 0x0000 and ext_len >= 5:
                entry_idx = idx + 2
                if entry_idx + 3 > idx + ext_len:
                    return None
                if data[entry_idx] != 0:
                    return None
                name_len = struct.unpack('>H', data[entry_idx+1:entry_idx+3])[0]
                return data[entry_idx+3:entry_idx+3+name_len].decode('ascii', errors='ignore')
            idx += ext_len
        return None
    except Exception:
        return None

def parse_host(data):
    try:
        text = data.decode('utf-8', errors='ignore')
        for line in text.split('\r\n'):
            s = line.strip()
            if s.lower().startswith('host:'):
                val = s[5:].strip()
                if ':' in val:
                    val = val.rsplit(':', 1)[0]
                return val
        return None
    except Exception:
        return None

def udp_resolve(query):
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.settimeout(5)
    try:
        s.sendto(query, (UPSTREAM_DNS, 53))
        resp, _ = s.recvfrom(4096)
        return resp
    finally:
        s.close()

def pump(src, dst):
    try:
        while True:
            data = src.recv(65536)
            if not data:
                break
            dst.sendall(data)
    except (ConnectionResetError, BrokenPipeError, OSError):
        pass
    finally:
        try:
            dst.shutdown(socket.SHUT_WR)
        except OSError:
            pass

def handle_dns(conn, data):
    """DNS: data = b'DNS' + 2-byte-len + query (may need more reads)."""
    try:
        payload = data[3:]
        if len(payload) < 2:
            return
        msg_len = struct.unpack('>H', payload[:2])[0]
        query = payload[2:2+msg_len]
        while len(query) < msg_len:
            chunk = conn.recv(msg_len - len(query))
            if not chunk:
                break
            query += chunk
        resp = udp_resolve(query)
        conn.sendall(struct.pack('>H', len(resp)) + resp)
    except Exception:
        pass
    finally:
        conn.close()

def handle_http_https(conn, data):
    """HTTP/HTTPS: DNAT'd raw connection from VM."""
    try:
        # Read enough to identify protocol
        while len(data) < 512:
            chunk = conn.recv(4096)
            if not chunk:
                return
            data += chunk
            if data[0] == 0x16:
                if len(data) >= 5:
                    rl = struct.unpack('>H', data[3:5])[0]
                    if len(data) >= 5 + rl:
                        break
            else:
                if b'\r\n\r\n' in data:
                    break

        if data[0] == 0x16:
            hostname = parse_sni(data)
            port = 443
        else:
            hostname = parse_host(data)
            port = 80

        if not hostname:
            conn.close()
            return

        if not is_allowed(hostname):
            conn.close()
            return

        upstream = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        upstream.settimeout(15)
        upstream.connect((hostname, port))
        upstream.settimeout(None)

        # Forward original bytes to real server
        upstream.sendall(data)

        t = threading.Thread(target=pump, args=(conn, upstream), daemon=True)
        t.start()
        pump(upstream, conn)
        t.join()
        conn.close()
        upstream.close()
    except Exception:
        try:
            conn.close()
        except OSError:
            pass

def handle_client(conn, addr):
    try:
        conn.settimeout(15)
        data = conn.recv(4096)
        if not data:
            conn.close()
            return
        if data.startswith(b"DNS"):
            handle_dns(conn, data)
        else:
            handle_http_https(conn, data)
    except Exception:
        try:
            conn.close()
        except OSError:
            pass

def main():
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    sock.bind((BIND_ADDR, BIND_PORT))
    sock.listen(128)
    n = len(load_whitelist())
    print(f"Host proxy on {BIND_ADDR}:{BIND_PORT} | {n} domains | HTTP/HTTPS+DNS", flush=True)
    while True:
        conn, addr = sock.accept()
        threading.Thread(target=handle_client, args=(conn, addr), daemon=True).start()

if __name__ == '__main__':
    main()
PYEOF

  nohup python3 "$HOST_PROXY_SCRIPT" "$HOST_PROXY_PORT" "$WHITELIST_FILE" > "$HOST_PROXY_LOG" 2>&1 &
  local pid=$!
  echo $pid > "$HOST_PROXY_PIDFILE"

  sleep 0.5
  if ! kill -0 $pid 2>/dev/null; then
    echo "ERROR: Host proxy failed to start. See $HOST_PROXY_LOG" >&2
    cat "$HOST_PROXY_LOG" >&2
    exit 1
  fi
  echo "  Host proxy ready on 127.0.0.1:$HOST_PROXY_PORT"
}

#--------------------------------------------------------------------------------
# VM FIREWALL (nftables REDIRECT + transparent proxy, runs inside VM via SSH)
#--------------------------------------------------------------------------------

setup_vm_firewall() {
  echo "  Setting up in-VM firewall (nftables DNAT + DNS helper)..."

  # Write the tiny DNS helper locally
  cat > "$INSTANCE_HOME/dns_proxy.py" <<'DNSPROXY'
#!/usr/bin/env python3
"""In-VM DNS helper: UDP :53 -> TCP to host proxy (with DNS magic prefix)."""
import socket, struct, threading, sys, os

PORT = int(sys.argv[1]) if len(sys.argv) > 1 else 14000

# Daemonize
if os.fork() > 0:
    sys.exit(0)
os.setsid()
if os.fork() > 0:
    sys.exit(0)

def fwd(q):
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(5)
    s.connect(("10.0.2.100", PORT))
    s.sendall(b"DNS" + struct.pack(">H", len(q)) + q)
    hdr = b""
    while len(hdr) < 2:
        hdr += s.recv(2 - len(hdr))
    n = struct.unpack(">H", hdr)[0]
    r = b""
    while len(r) < n:
        r += s.recv(n - len(r))
    s.close()
    return r

def h(sock, d, a):
    try:
        r = fwd(d)
        if r:
            sock.sendto(r, a)
    except Exception:
        pass

s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
s.bind(("0.0.0.0", 53))
while True:
    d, a = s.recvfrom(4096)
    threading.Thread(target=h, args=(s, d, a), daemon=True).start()
DNSPROXY

  # Write the OpenRC init script locally
  cat > "$INSTANCE_HOME/dns_proxy.init" <<INIEOF
#!/sbin/openrc-run
name=dns_proxy
command=/usr/bin/python3
command_args="/usr/local/bin/dns_proxy.py $HOST_PROXY_PORT"
command_user=root
INIEOF

  # Write the nftables ruleset locally (avoids brace-quoting over SSH)
  cat > "$INSTANCE_HOME/sandbox_proxy.nft" <<NFT
table ip sandbox_proxy {
  chain out {
    type nat hook output priority -1
    ip daddr 10.0.2.0/24 return
    ip daddr 127.0.0.1 return
    tcp dport 80 dnat to 10.0.2.100:$HOST_PROXY_PORT
    tcp dport 443 dnat to 10.0.2.100:$HOST_PROXY_PORT
  }
}
NFT

  # Copy all files into VM
  local scp_opts="-i $SSH_KEY -P $SSH_PORT -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
  scp $scp_opts "$INSTANCE_HOME/dns_proxy.py" "root@127.0.0.1:/usr/local/bin/dns_proxy.py" 2>/dev/null
  scp $scp_opts "$INSTANCE_HOME/dns_proxy.init" "root@127.0.0.1:/etc/init.d/dns_proxy" 2>/dev/null
  scp $scp_opts "$INSTANCE_HOME/sandbox_proxy.nft" "root@127.0.0.1:/tmp/sandbox_proxy.nft" 2>/dev/null

  # Apply: nftables from file + DNS service + resolv.conf
  _ssh root "
    set -e
    && nft delete table ip sandbox_proxy 2>/dev/null || true
    && nft -f /tmp/sandbox_proxy.nft
    && ip route add default via 10.0.2.2
    && rc-service dhcpcd stop 2>/dev/null || pkill dhcpcd 2>/dev/null || true
    && sleep 0.3
    && printf 'nameserver 127.0.0.1' > /etc/resolv.conf
    && chmod 444 /etc/resolv.conf
    && chmod +x /etc/init.d/dns_proxy
    && rc-service dns_proxy start
  "

  echo "  VM firewall active: nftables DNAT -> host proxy | DNS via 127.0.0.1"
}

