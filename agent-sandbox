clean_session_files() {
  for file in "$SESSION_IMAGE" "$OVMF_VARS_COPY"; do
    if [[ -f "$file" ]]; then
      echo "Deleting $file"
      rm -f "$file"
      sleep 2
    fi
  done
}

_clean(){
  if [[ -d "$INSTANCE_HOME" ]]; then
    _stop
    clean_session_files
  fi
}

